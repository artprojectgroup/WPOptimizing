msgstr[4] "%1$d جدولًا كبيرًا كاد لا يحتوي مساحة فارغة للاسترداد وتم تخطيه: %2$s."
msgstr[5] "%1$d جدول كبير كاد لا يحتوي مساحة فارغة للاسترداد وتم تخطيه: %2$s."

#. translators: 1: number of tables, 2: their names.
#: includes/admin/trait-tables.php
#, php-format
msgid "%1$d large table will be rebuilt in the background, one at a time and without stopping the site: %2$s. You can leave this page."
msgid_plural "%1$d large tables will be rebuilt in the background, one at a time and without stopping the site: %2$s. You can leave this page."
msgstr[0] "سيُعاد بناء %1$d جدول كبير في الخلفية، واحدًا تلو الآخر ودون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."
msgstr[1] "سيُعاد بناء جدول كبير واحد (%1$d) في الخلفية، دون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."
msgstr[2] "سيُعاد بناء جدولين كبيرين (%1$d) في الخلفية، واحدًا تلو الآخر ودون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."
msgstr[3] "سيُعاد بناء %1$d جداول كبيرة في الخلفية، واحدًا تلو الآخر ودون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."
msgstr[4] "سيُعاد بناء %1$d جدولًا كبيرًا في الخلفية، واحدًا تلو الآخر ودون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."
msgstr[5] "سيُعاد بناء %1$d جدول كبير في الخلفية، واحدًا تلو الآخر ودون إيقاف الموقع: %2$s. يمكنك مغادرة هذه الصفحة."

#. translators: 1: table name, 2: time since it started, e.g. "5 mins".
#: includes/admin/trait-tables.php
#, php-format
msgid "%1$s is being rebuilt in the background (started %2$s ago). The site keeps working meanwhile."
msgstr "يُعاد بناء %1$s في الخلفية (بدأ منذ %2$s). يستمر الموقع في العمل خلال ذلك."

#. translators: %s: table names.
#: includes/admin/trait-tables.php
#, php-format
msgid "Waiting to be rebuilt: %s."
msgstr "بانتظار إعادة البناء: %s."

#. translators: 1: table name, 2: reason.
#: includes/admin/trait-tables.php
#, php-format
msgid "%1$s was not rebuilt: %2$s."
msgstr "لم يُعَد بناء %1$s: %2$s."

#. translators: 1: table name, 2: space recovered, e.g. "1.2 GB".
#: includes/admin/trait-tables.php
#, php-format
msgid "%1$s rebuilt: %2$s recovered."
msgstr "أُعيد بناء %1$s: استُرد %2$s."

#: includes/admin/trait-tables.php
msgid "Large tables rebuilt in the background"
msgstr "جداول كبيرة أُعيد بناؤها في الخلفية"

#: includes/admin/trait-cache.php
msgid "A page cache you no longer use left things behind"
msgstr "تركت ذاكرة تخزين مؤقت للصفحات لم تعد تستخدمها بقايا خلفها"

#. translators: %s: plugin name, e.g. WP Super Cache.
#: includes/admin/trait-cache.php
#, php-format
msgid "Rules from %s in .htaccess, which keep serving old pages before WordPress runs."
msgstr "قواعد من %s في ملف .htaccess، لا تزال تقدّم صفحات قديمة قبل أن يعمل ووردبريس."

#. translators: %s: plugin name.
#: includes/admin/trait-cache.php
#, php-format
msgid "wp-content/advanced-cache.php from %s, which is no longer active but still loads on every visit."
msgstr "الملف wp-content/advanced-cache.php من %s، الذي لم يعد نشطًا لكنه لا يزال يُحمَّل في كل زيارة."

#: includes/admin/trait-cache.php
msgid "wp-content/advanced-cache.php from a plugin that is no longer active, which still loads on every visit."
msgstr "الملف wp-content/advanced-cache.php من إضافة لم تعد نشطة، ولا يزال يُحمَّل في كل زيارة."

#: includes/admin/trait-cache.php
msgid "A second WP_CACHE line in wp-config.php, which makes PHP warn on every visit."
msgstr "سطر WP_CACHE ثانٍ في wp-config.php، يجعل PHP يُظهر تحذيرًا في كل زيارة."

#: includes/admin/trait-cache.php
msgid "Each file is copied to Backups before it is changed, so this can be undone."
msgstr "يُنسخ كل ملف إلى النسخ الاحتياطية قبل تغييره، لذا يمكن التراجع عن ذلك."

#: includes/admin/trait-cache.php
msgid "Remove what was left behind"
msgstr "إزالة البقايا"

#: includes/admin/trait-cache.php
msgid "You do not have permission to change these files."
msgstr "ليست لديك صلاحية تغيير هذه الملفات."

#: includes/admin/trait-cache.php
msgid "Removed what the old page cache left behind. The previous files are in Backups."
msgstr "تمت إزالة بقايا ذاكرة التخزين المؤقت للصفحات السابقة. الملفات السابقة موجودة في النسخ الاحتياطية."

#: includes/admin/trait-cache.php
msgid "Some of it could not be removed: the file is not writable or could not be backed up first, so it was left as it was."
msgstr "تعذّرت إزالة جزء منها: الملف غير قابل للكتابة أو تعذّر نسخه احتياطيًا أولًا، لذا تُرك كما كان."

#. translators: %s: hosting or server cache names, e.g. WP Engine.
#: includes/admin/trait-cache.php
#, php-format
msgid "Your hosting already keeps a copy of every page (%s), and WPOptimizing cannot clear it. A second page cache would leave visitors seeing old pages after each change, so it was not enabled. The object cache and the other speed-ups still work alongside it."
msgstr "تحتفظ استضافتك بالفعل بنسخة من كل صفحة (%s)، ولا يستطيع WPOptimizing مسحها. ذاكرة تخزين مؤقت ثانية للصفحات ستجعل الزوار يرون صفحات قديمة بعد كل تغيير، لذلك لم تُفعَّل. تستمر ذاكرة التخزين المؤقت للكائنات وتحسينات السرعة الأخرى في العمل إلى جانبها."

#. translators: %s: plugin name, e.g. WP Rocket.
#: includes/page-cache.php
#, php-format
msgid "%s replaced WPOptimizing's page cache file, so pages are now cached by it. WPOptimizing's page cache has been switched off so the two do not get in each other's way."
msgstr "استبدلت %s ملف ذاكرة التخزين المؤقت للصفحات الخاص بـ WPOptimizing، لذا أصبحت هي التي تخزّن الصفحات الآن. تم إيقاف ذاكرة التخزين المؤقت للصفحات في WPOptimizing حتى لا تتعارضا."

#: includes/importers
#, php-format
msgid "%1$s: these patterns use regular expressions, which WPOptimizing does not read, so they were not imported. Add them again as plain text: %2$s"
msgstr "%1$s: تستخدم هذه الأنماط تعابير نمطية لا يقرؤها WPOptimizing، لذلك لم تُستورد. أضفها مرة أخرى كنص عادي: %2$s"

#: includes/importers
msgid "Page lifetime: the other plugin kept pages for longer than 12 hours (or for ever). Forms and «add to cart» buttons stop working on pages that old, so it was set to 10 hours."
msgstr "مدة صلاحية الصفحات: كانت الإضافة الأخرى تحتفظ بالصفحات أكثر من 12 ساعة (أو إلى الأبد). تتوقف النماذج وأزرار «أضف إلى السلة» عن العمل في الصفحات بهذا القِدم، لذلك ضُبطت على 10 ساعات."

#: includes/importers
msgid "Cache lifespan"
msgstr "مدة صلاحية التخزين المؤقت"

#: includes/importers
msgid "Never cache URL(s)"
msgstr "عدم تخزين عناوين URL مؤقتًا أبدًا"

#: includes/importers
msgid "Never cache cookies"
msgstr "عدم التخزين المؤقت أبدًا مع ملفات تعريف الارتباط هذه"

#: includes/importers
msgid "Cache query string(s)"
msgstr "تخزين سلاسل الاستعلام مؤقتًا"

#: includes/importers
msgid "Separate cache files for mobile devices"
msgstr "ملفات تخزين مؤقت منفصلة للأجهزة المحمولة"

#: includes/importers
msgid "Activate preloading"
msgstr "تفعيل التحميل المسبق"

#: includes/importers
msgid "Enable caching for logged-in WordPress users: WPOptimizing never serves cached pages to logged-in users."
msgstr "تفعيل التخزين المؤقت للمستخدمين المسجّلين: لا يقدّم WPOptimizing أبدًا صفحات مخزنة مؤقتًا للمستخدمين المسجّلين."

#: includes/importers
msgid "Never cache user agent(s): not imported; WPOptimizing keeps its own fixed list."
msgstr "عدم التخزين المؤقت أبدًا لوكلاء المستخدم هؤلاء: لم يُستورد؛ يحتفظ WPOptimizing بقائمته الثابتة الخاصة."

#: includes/importers
msgid "Always purge URL(s): not imported; WPOptimizing purges the pages a change affects on its own."
msgstr "تفريغ عناوين URL هذه دائمًا: لم يُستورد؛ يفرّغ WPOptimizing بنفسه الصفحات التي يؤثر فيها كل تغيير."

#: includes/importers
msgid "Minify CSS files"
msgstr "تصغير ملفات CSS"

#: includes/importers
msgid "Minify JavaScript files"
msgstr "تصغير ملفات JavaScript"

#: includes/importers
msgid "Excluded CSS and JavaScript files"
msgstr "ملفات CSS وJavaScript المستثناة"

#: includes/importers
msgid "Load JavaScript deferred"
msgstr "تحميل JavaScript مؤجَّلًا"

#: includes/importers
msgid "Excluded JavaScript files (deferred)"
msgstr "ملفات JavaScript المستثناة (مؤجَّلة)"

#: includes/importers
msgid "Load CSS asynchronously"
msgstr "تحميل CSS بشكل غير متزامن"

#: includes/importers
msgid "Fallback critical CSS"
msgstr "CSS حرج احتياطي"

#: includes/importers
msgid "Delay JavaScript execution"
msgstr "تأخير تنفيذ JavaScript"

#: includes/importers
msgid "Excluded JavaScript files (delayed)"
msgstr "ملفات JavaScript المستثناة (مؤخَّرة)"

#: includes/importers
msgid "Combine JavaScript files: not imported. Combining files makes HTTP/2 sites slower and breaks scripts, so WPOptimizing does not do it."
msgstr "دمج ملفات JavaScript: لم يُستورد. يُبطئ دمج الملفات المواقع التي تعمل بـ HTTP/2 ويعطّل السكربتات، لذلك لا يقوم به WPOptimizing."

#: includes/importers
msgid "Remove Unused CSS: WP Rocket's own online service, not imported. WPOptimizing generates critical CSS on your server instead."
msgstr "إزالة CSS غير المستخدم: خدمة إلكترونية خاصة بـ WP Rocket، لم تُستورد. يُنشئ WPOptimizing بدلًا من ذلك CSS الحرج على خادمك."

#: includes/importers
msgid "LazyLoad for images and iframes"
msgstr "التحميل الكسول للصور وإطارات iframe"

#: includes/importers
msgid "Replace YouTube iframe with preview image"
msgstr "استبدال إطار YouTube بصورة معاينة"

#: includes/importers
msgid "Self-host Google Fonts"
msgstr "استضافة خطوط Google ذاتيًا"

#: includes/importers
msgid "Preload fonts"
msgstr "التحميل المسبق للخطوط"

#: includes/importers
msgid "Prefetch DNS requests"
msgstr "الجلب المسبق لطلبات DNS"

#: includes/importers
msgid "Prefetch DNS requests: WPOptimizing finds the hosts to connect to early on its own, so the list itself was not copied."
msgstr "الجلب المسبق لطلبات DNS: يحدد WPOptimizing بنفسه الخوادم التي يتصل بها مبكرًا، لذلك لم تُنسخ القائمة."

#: includes/importers
msgid "Excluded images or iframes (LazyLoad): not imported."
msgstr "الصور أو إطارات iframe المستثناة (التحميل الكسول): لم تُستورد."

#: includes/importers
msgid "Disable WordPress emoji"
msgstr "تعطيل رموز WordPress التعبيرية"

#: includes/importers
msgid "Enable Content Delivery Network"
msgstr "تفعيل شبكة توصيل المحتوى (CDN)"

#: includes/importers
msgid "CDN CNAME(s)"
msgstr "أسماء CNAME لشبكة CDN"

#: includes/importers
msgid "CDN CNAME(s): WPOptimizing uses one CDN host, so only the first one was imported."
msgstr "أسماء CNAME لشبكة CDN: يستخدم WPOptimizing خادم CDN واحدًا، لذلك استُورد الأول فقط."

#: includes/importers
msgid "Auto drafts"
msgstr "المسودات التلقائية"

#: includes/importers
msgid "Spam comments"
msgstr "تعليقات مزعجة"

#: includes/importers
msgid "Trashed comments"
msgstr "التعليقات في سلة المهملات"

#: includes/importers
msgid "All transients"
msgstr "جميع البيانات المؤقتة"

#: includes/importers
msgid "Revisions: WP Rocket deletes all of them; WPOptimizing keeps the last two of each post, which you can change in General cleanup."
msgstr "المراجعات: يحذفها WP Rocket كلها؛ يحتفظ WPOptimizing بآخر مراجعتين لكل مقالة، ويمكنك تغيير ذلك في التنظيف العام."

#: includes/importers
msgid "Schedule automatic cleanup"
msgstr "جدولة التنظيف التلقائي"

#: includes/importers
msgid "Control Heartbeat"
msgstr "التحكم في Heartbeat"

#: includes/importers
msgid "Cloudflare: WP Rocket uses your account's Global API Key, which WPOptimizing does not copy. Connect Cloudflare in Cache › Cloudflare with an API token."
msgstr "Cloudflare: يستخدم WP Rocket مفتاح Global API Key الخاص بحسابك، ولا ينسخه WPOptimizing. اربط Cloudflare من التخزين المؤقت › Cloudflare باستخدام رمز API."

#: includes/importers
msgid "Varnish: switch on its purge in Cache › Browser & server once WPOptimizing has checked that Varnish is in front of the site."
msgstr "Varnish: فعّل التفريغ من التخزين المؤقت › المتصفح والخادم بعد أن يتحقق WPOptimizing من أن Varnish يقع أمام الموقع."

#: includes/importers
msgid "Import from another plugin"
msgstr "الاستيراد من إضافة أخرى"

#: includes/importers
msgid "Moving from another cache or performance plugin? WPOptimizing reads the settings it left on this site, even if it is deactivated, and brings over what has an equivalent here. Passwords, licence and API keys are never copied, and nothing that changes files (the page cache, the object cache) is switched on by an import."
msgstr "هل تنتقل من إضافة أخرى للتخزين المؤقت أو الأداء؟ يقرأ WPOptimizing الإعدادات التي تركتها على هذا الموقع، حتى لو كانت معطّلة، وينقل ما له مقابل هنا. لا تُنسخ أبدًا كلمات المرور ولا التراخيص ولا مفاتيح API، ولا يفعّل الاستيراد أي شيء يغيّر الملفات (التخزين المؤقت للصفحات أو للكائنات)."

#: includes/importers
msgid "On"
msgstr "مفعّل"

#: includes/importers
msgid "No settings from another cache or performance plugin were found on this site."
msgstr "لم يُعثر على هذا الموقع على إعدادات إضافة أخرى للتخزين المؤقت أو الأداء."

#: includes/importers
msgid "Its settings have nothing WPOptimizing can bring over."
msgstr "لا تحتوي إعداداته على أي شيء يمكن لـ WPOptimizing نقله."

#: includes/importers
#, php-format
msgid "Import from %s"
msgstr "الاستيراد من %s"

#: includes/importers
#, php-format
msgid "Undo the import from %1$s (%2$s)"
msgstr "التراجع عن الاستيراد من %1$s (%2$s)"

#: includes/importers
msgid "The settings are back to how they were before the import."
msgstr "عادت الإعدادات إلى ما كانت عليه قبل الاستيراد."

#: includes/importers
msgid "There is no import to undo."
msgstr "لا يوجد استيراد للتراجع عنه."

#: includes/importers
msgid "That plugin cannot be imported from."
msgstr "لا يمكن الاستيراد من هذه الإضافة."

#: includes/importers
msgid "Nothing was imported: none of its settings could be brought over."
msgstr "لم يُستورد أي شيء: تعذّر نقل أي من إعداداته."

#: includes/importers
#, php-format
msgid "Settings imported from %s. Check the pages they belong to, and switch the page cache or the object cache on yourself when the other plugin is deactivated. You can undo the import below."
msgstr "استُوردت الإعدادات من %s. راجع الشاشات التي تنتمي إليها، وفعّل بنفسك التخزين المؤقت للصفحات أو للكائنات بعد تعطيل الإضافة الأخرى. يمكنك التراجع عن الاستيراد أدناه."

#: includes/importers
#, php-format
msgid "%d setting would be imported"
msgid_plural "%d settings would be imported"
msgstr[0] "لن يُستورد أي إعداد (%d)"
msgstr[1] "سيُستورد إعداد واحد (%d)"
msgstr[2] "سيُستورد إعدادان (%d)"
msgstr[3] "ستُستورد %d إعدادات"
msgstr[4] "سيُستورد %d إعدادًا"
msgstr[5] "سيُستورد %d إعداد"

#: includes/page-cache-static.php
msgid "Purge this page"
msgstr "تفريغ هذه الصفحة"

#: includes/page-cache-static.php
msgid "Delete the cached copy of this page here, at Cloudflare and in Varnish"
msgstr "يحذف النسخة المخزنة مؤقتًا من هذه الصفحة هنا وفي Cloudflare وVarnish"

#: includes/page-cache-static.php
msgid "Also ignore these tracking parameters (the page is cached as if they were not there)"
msgstr "تجاهل معلمات التتبع هذه أيضًا (تُخزَّن الصفحة مؤقتًا كأنها غير موجودة)"

#: includes/page-cache-static.php
msgid "parameter name, e.g. ref"
msgstr "اسم المعلمة، مثل ref"

#: includes/page-cache-static.php
msgid "Never cache for these browsers or bots"
msgstr "عدم استخدام التخزين المؤقت أبدًا لهذه المتصفحات أو الروبوتات"

#: includes/page-cache-static.php
msgid "part of the user agent, e.g. Lighthouse"
msgstr "جزء من وكيل المستخدم، مثل Lighthouse"

#: includes/page-cache-static.php
msgid "Serve without PHP"
msgstr "التقديم دون PHP"

#: includes/page-cache-static.php
msgid "The web server answers from the cached file directly, without starting PHP: faster pages and far more visitors at once on the same server. Only pages that need nothing from PHP are served this way (no separate mobile copy, currency, query string or security headers sent from PHP); the rest keep going through PHP as now."
msgstr "يجيب خادم الويب مباشرةً من الملف المخزّن مؤقتًا دون تشغيل PHP: صفحات أسرع وعدد أكبر بكثير من الزوار في الوقت نفسه على الخادم نفسه. لا تُقدَّم بهذه الطريقة إلا الصفحات التي لا تحتاج إلى شيء من PHP (من دون نسخة منفصلة للجوال أو عملة أو سلسلة استعلام أو ترويسات أمان يرسلها PHP)؛ وتستمر بقية الصفحات بالمرور عبر PHP كما الآن."

#: includes/page-cache-static.php
msgid "Serve cached pages straight from the web server (adds rules to .htaccess, backed up first)"
msgstr "تقديم الصفحات المخزنة مؤقتًا مباشرةً من خادم الويب (يضيف قواعد إلى .htaccess مع نسخة احتياطية مسبقة)"

#: includes/page-cache-static.php
msgid "This server does not read .htaccess (it is probably Nginx), so WordPress cannot add the rules itself. Whoever manages the server can add these lines to the site's configuration:"
msgstr "لا يقرأ هذا الخادم ملف .htaccess (غالبًا هو Nginx)، لذا لا يستطيع ووردبريس إضافة القواعد بنفسه. يمكن لمن يدير الخادم إضافة هذه الأسطر إلى إعدادات الموقع:"

#: includes/page-cache-static.php
msgid "Never cache user agent(s)"
msgstr "عدم التخزين المؤقت أبدًا لوكلاء المستخدم هؤلاء"

#: includes/importers
msgid "URLs to exclude from caching"
msgstr "عناوين URL المستثناة من التخزين المؤقت"

#: includes/importers
msgid "Cookies which, if present, will prevent caching"
msgstr "ملفات تعريف الارتباط التي تمنع التخزين المؤقت عند وجودها"

#: includes/importers
msgid "Generate separate files for mobile devices"
msgstr "إنشاء ملفات منفصلة للأجهزة المحمولة"

#: includes/importers
msgid "Automatically preload content after it is purged"
msgstr "التحميل المسبق للمحتوى تلقائيًا بعد مسحه"

#: includes/importers
#, php-format
msgid "%s: WPOptimizing never serves cached pages to logged-in users."
msgstr "%s: لا يقدّم WPOptimizing أبدًا صفحات مخزنة مؤقتًا للمستخدمين المسجلين دخولهم."

#: includes/importers
msgid "Serve cached pages to logged in users"
msgstr "تقديم الصفحات المخزنة مؤقتًا للمستخدمين المسجلين"

#: includes/importers
msgid "List of browser agent strings which, if detected, will prevent caching"
msgstr "قائمة سلاسل وكيل المتصفح التي تمنع التخزين المؤقت عند اكتشافها"

#: includes/importers
msgid "Ignore these query variables when caching"
msgstr "تجاهل متغيرات الاستعلام هذه عند التخزين المؤقت"

#: includes/importers
#, php-format
msgid "%s: not imported."
msgstr "%s: لم يُستورد."

#: includes/importers
msgid "Conditional tags to exclude from caching"
msgstr "الوسوم الشرطية المستثناة من التخزين المؤقت"

#: includes/importers
msgid "Cache Specific URLs Only"
msgstr "تخزين عناوين URL محددة فقط مؤقتًا"

#: includes/importers
#, php-format
msgid "Cloudflare: the credentials %s keeps are not copied. Connect Cloudflare in Cache › Cloudflare with an API token."
msgstr "Cloudflare: لا تُنسخ بيانات الاعتماد التي يحتفظ بها %s. اربط Cloudflare من التخزين المؤقت › Cloudflare باستخدام رمز API."

#: includes/importers
msgid "Enable minification of CSS files"
msgstr "تفعيل تصغير ملفات CSS"

#: includes/importers
msgid "Enable minification of JavaScript files"
msgstr "تفعيل تصغير ملفات JavaScript"

#: includes/importers
msgid "Exclude JavaScript from processing"
msgstr "استثناء JavaScript من المعالجة"

#: includes/importers
msgid "Defer all the JavaScript files"
msgstr "تأجيل جميع ملفات JavaScript"

#: includes/importers
#, php-format
msgid "%s: WPOptimizing defers every script except the ones you exclude, not a chosen few, so this list was not imported."
msgstr "%s: يؤجّل WPOptimizing كل السكربتات باستثناء ما تستثنيه، وليس بعضها المختار، لذا لم تُستورد هذه القائمة."

#: includes/importers
msgid "Asynchronously load selected JavaScript files"
msgstr "تحميل ملفات JavaScript المحددة بشكل غير متزامن"

