msgid_plural "%1$d large tables had almost no free space to recover and were skipped: %2$s."
msgstr[0] "%1$d große Tabelle hatte kaum freien Speicher zurückzugewinnen und wurde übersprungen: %2$s."
msgstr[1] "%1$d große Tabellen hatten kaum freien Speicher zurückzugewinnen und wurden übersprungen: %2$s."

#. translators: 1: number of tables, 2: their names.
#: includes/admin/trait-tables.php
#, php-format
msgid "%1$d large table will be rebuilt in the background, one at a time and without stopping the site: %2$s. You can leave this page."
msgid_plural "%1$d large tables will be rebuilt in the background, one at a time and without stopping the site: %2$s. You can leave this page."
msgstr[0] "%1$d große Tabelle wird im Hintergrund neu aufgebaut, eine nach der anderen und ohne die Website anzuhalten: %2$s. Du kannst diese Seite verlassen."
msgstr[1] "%1$d große Tabellen werden im Hintergrund neu aufgebaut, eine nach der anderen und ohne die Website anzuhalten: %2$s. Du kannst diese Seite verlassen."

#. translators: 1: table name, 2: time since it started, e.g. "5 mins".
