msgstr "Regeln von %s in der .htaccess, die weiterhin alte Seiten ausliefern, bevor WordPress startet."

#. translators: %s: plugin name.
#: includes/admin/trait-cache.php
#, php-format
msgid "wp-content/advanced-cache.php from %s, which is no longer active but still loads on every visit."
msgstr "wp-content/advanced-cache.php von %s, das nicht mehr aktiv ist, aber bei jedem Besuch weiter geladen wird."

#: includes/admin/trait-cache.php
msgid "wp-content/advanced-cache.php from a plugin that is no longer active, which still loads on every visit."
msgstr "wp-content/advanced-cache.php eines nicht mehr aktiven Plugins, das bei jedem Besuch weiter geladen wird."

#: includes/admin/trait-cache.php
msgid "A second WP_CACHE line in wp-config.php, which makes PHP warn on every visit."
msgstr "Eine zweite WP_CACHE-Zeile in der wp-config.php, wegen der PHP bei jedem Besuch eine Warnung ausgibt."

#: includes/admin/trait-cache.php
msgid "Each file is copied to Backups before it is changed, so this can be undone."
msgstr "Jede Datei wird vor der Änderung in die Sicherungen kopiert, du kannst es also rückgängig machen."

#: includes/admin/trait-cache.php
