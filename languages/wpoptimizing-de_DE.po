#: includes/admin/trait-media-audit.php:739
#, php-format
msgid "Thumbnails regenerated for %1$d attachment(s); %2$d could not be (file missing or not an image). The old sizes are listed under \"Sizes replaced by a regeneration\"."
msgstr "Vorschaubilder für %1$d Anhang/Anhänge neu erzeugt; %2$d konnten nicht neu erzeugt werden (Datei fehlt oder kein Bild). Die alten Größen stehen unter „Durch Neuerzeugung ersetzte Größen“."

