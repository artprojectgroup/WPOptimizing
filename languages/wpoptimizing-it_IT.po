msgstr "la tabella, da aprire in un foglio di calcolo; «Vedi rapporto» apre una versione stampabile."

#: includes/admin/class-help.php:1121
#: includes/admin/class-network-dashboard.php:1155
msgid "Email alerts"
msgstr "Avvisi email"

#: includes/admin/class-help.php:1121
