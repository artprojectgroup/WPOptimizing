msgid_plural "Remove %s WebP copies"
msgstr[0] "Rimuovi %s copia WebP"
msgstr[1] "Rimuovi %s copie WebP"

#. translators: %s: number of images.
#: includes/admin/trait-media.php:705
#, php-format
msgid "Generate %s AVIF copy"
msgid_plural "Generate %s AVIF copies"
msgstr[0] "Genera %s copia AVIF"
msgstr[1] "Genera %s copie AVIF"

