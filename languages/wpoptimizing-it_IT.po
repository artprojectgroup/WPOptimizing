msgstr "%s è attivo e distribuisce già WebP/AVIF sul front-end, quindi WPOptimizing non lo farà — puoi comunque generare copie qui."

#: includes/admin/trait-media.php:664
msgid "Optimize the originals first: the copies are then created from the lighter, optimized images."
msgstr "Ottimizza prima gli originali: le copie vengono poi create dalle immagini ottimizzate, più leggere."

#. translators: %s: number of images.
#: includes/admin/trait-media.php:677
#, php-format
