msgstr "%d px"

#. translators: %d: number of seconds.
#: includes/importers/importer.php
#, php-format
msgid "%d second"
msgid_plural "%d seconds"
msgstr[0] "%d seconde"
msgstr[1] "%d secondes"

#: includes/importers/source-wp-optimize.php
msgid "Clean all post revisions"
msgstr "Nettoyer toutes les révisions des articles"

#: includes/admin-bar.php
msgid "Regenerate critical CSS"
msgstr "Régénérer le CSS critique"

#: includes/admin-bar.php
msgid "Regenerate the critical CSS of every template in the background, then purge the page cache"
msgstr "Régénère en arrière-plan le CSS critique de tous les modèles, puis vide le cache de page"

#: includes/admin-bar.php
msgid "Regenerating in the background ✓"
msgstr "Régénération en arrière-plan ✓"

#: includes/admin-bar.php
msgid "Regenerate the critical CSS of every template now? The current one stays in use until the new one is ready."
msgstr "Régénérer maintenant le CSS critique de tous les modèles ? L’actuel reste utilisé jusqu’à ce que le nouveau soit prêt."

#: includes/admin/trait-performance.php
msgid "The critical CSS is being regenerated in the background; the cached pages will be emptied when it is ready."
msgstr "Le CSS critique est en cours de régénération en arrière-plan ; les pages en cache seront vidées quand il sera prêt."

#: includes/admin/trait-performance.php
msgid "To regenerate it without any change, use “Regenerate critical CSS” in the WPOptimizing toolbar menu."
msgstr "Pour le régénérer sans aucun changement, utilisez « Régénérer le CSS critique » dans le menu WPOptimizing de la barre d’outils."

#: includes/admin/trait-cache.php
msgid "Not cached: the page was cut short (the visitor left, the time limit or a fatal error)"
msgstr "Non mise en cache : la page a été interrompue (le visiteur est parti, délai dépassé ou erreur fatale)"

