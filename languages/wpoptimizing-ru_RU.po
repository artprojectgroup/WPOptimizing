#, php-format
msgid "%s: WPOptimizing does not load Google Fonts asynchronously; it serves them from your own server instead, which is faster and sends nothing to Google."
msgstr "%s: WPOptimizing не загружает Google Fonts асинхронно; он отдаёт их с вашего собственного сервера, что быстрее и ничего не отправляет в Google."

#: includes/importers
msgid "Remove Google Fonts"
msgstr "Удалить Google Fonts"

#: includes/importers
msgid "DNS Prefetch / DNS Preconnect"
msgstr "Предзагрузка DNS / Предварительное подключение"

#: includes/importers
msgid "Instant Click"
msgstr "Мгновенный клик"

#: includes/importers
msgid "Use CDN Mapping"
msgstr "Использовать сопоставление CDN"

#: includes/importers
msgid "Original Directories"
msgstr "Исходные каталоги"

#: includes/importers
#, php-format
msgid "%s: WPOptimizing uses one CDN host, so only the first one was imported."
msgstr "%s: WPOptimizing использует один хост CDN, поэтому импортирован только первый."

#: includes/importers
#, php-format
msgid "%s: the other plugin connects to Cloudflare with your account's credentials, which WPOptimizing does not copy. Connect Cloudflare in Cache › Cloudflare with an API token."
msgstr "%s: другой плагин подключается к Cloudflare с учётными данными вашей учётной записи, которые WPOptimizing не копирует. Подключите Cloudflare в разделе «Кеш › Cloudflare» с помощью API-токена."

#: includes/importers
msgid "Cloudflare API"
msgstr "API Cloudflare"

#: includes/importers
msgid "Revisions Max Number"
msgstr "Максимальное число ревизий"

#: includes/importers
msgid "Revisions Max Age"
msgstr "Максимальный возраст ревизий"

#: includes/importers
#, php-format
msgid "%s: the other plugin set the Heartbeat separately for each place; WPOptimizing uses one value for the whole site, so the strictest one was kept."
msgstr "%s: другой плагин настраивал Heartbeat отдельно для каждой области; WPOptimizing использует одно значение для всего сайта, поэтому сохранено самое строгое."

#: includes/importers
msgid "Host"
msgstr "Хост"

#: includes/importers
msgid "Port"
msgstr "Порт"

#: includes/importers
msgid "Redis Database ID"
msgstr "ID базы данных Redis"

#: includes/importers
#, php-format
msgid "%s: the connection was imported, but not switched on and without any password. If the server needs one, type it again in Cache › Object cache."
msgstr "%s: подключение импортировано, но не включено и без пароля. Если серверу нужен пароль, введите его снова в разделе «Кеш › Объектный кеш»."

#: includes/importers
msgid "Maximum lifetime of cache objects"
msgstr "Максимальное время жизни объектов кеша"

#: includes/importers
msgid "Never cache the following pages"
msgstr "Никогда не кешировать следующие страницы"

#: includes/importers
msgid "Rejected cookies"
msgstr "Отклонённые cookie"

#: includes/importers
msgid "Rejected user agents"
msgstr "Отклонённые user agent"

#: includes/importers
msgid "Accepted query strings"
msgstr "Принимаемые строки запроса"

#: includes/importers
msgid "User Agent Groups"
msgstr "Группы user agent"

#: includes/importers
msgid "User Agent Groups: WPOptimizing keeps one separate copy for all mobile devices, without groups, themes or redirects of its own."
msgstr "Группы user agent: WPOptimizing хранит одну отдельную копию для всех мобильных устройств, без собственных групп, тем и перенаправлений."

#: includes/importers
msgid "Automatically prime the page cache"
msgstr "Автоматически прогревать страничный кеш"

#: includes/importers
msgid "Don't cache pages for logged in users"
msgstr "Не кешировать страницы для вошедших пользователей"

#: includes/importers
msgid "Page Cache Method: W3 Total Cache kept pages in memory (Memcached, Redis or APC); WPOptimizing keeps them on disk."
msgstr "Метод страничного кеша: W3 Total Cache хранил страницы в памяти (Memcached, Redis или APC); WPOptimizing хранит их на диске."

#: includes/importers
msgid "Minify › CSS"
msgstr "Минификация › CSS"

#: includes/importers
msgid "Minify › JS"
msgstr "Минификация › JS"

#: includes/importers
msgid "Never minify the following JS / CSS files"
msgstr "Никогда не минифицировать следующие файлы JS / CSS"

#: includes/importers
msgid "Embed type"
msgstr "Тип встраивания"

#: includes/importers
#, php-format
msgid "%s: WPOptimizing defers every script except the ones you exclude, wherever it sits in the page. Check the exclusions after importing."
msgstr "%s: WPOptimizing откладывает все скрипты, кроме исключённых, где бы они ни находились на странице. Проверьте исключения после импорта."

#: includes/importers
msgid "Minify › JS › Combine only"
msgstr "Минификация › JS › Только объединение"

#: includes/importers
msgid "Minify › HTML & XML"
msgstr "Минификация › HTML и XML"

#: includes/importers
msgid "Delay Scripts and Preload Requests: they are W3 Total Cache Pro features and this site has no Pro licence, so they were not acting and were not imported."
msgstr "Задержка скриптов и Предзагрузка запросов: это функции W3 Total Cache Pro, а у этого сайта нет лицензии Pro, поэтому они не работали и не импортированы."

#: includes/importers
msgid "Delay Scripts"
msgstr "Задержка скриптов"

#: includes/importers
msgid "Delay Scripts › Timeout"
msgstr "Задержка скриптов › Тайм-аут"

#: includes/importers
msgid "Preload Requests"
msgstr "Предзагрузка запросов"

#: includes/importers
msgid "DNS Prefetch / Preconnect"
msgstr "Предзагрузка DNS / Предварительное подключение"

#: includes/importers
msgid "Disable wp-embed script"
msgstr "Отключить скрипт wp-embed"

#: includes/importers
msgid "Disable jquery-migrate on the front-end"
msgstr "Отключить jquery-migrate на сайте"

#: includes/importers
msgid "CDN"
msgstr "CDN"

#: includes/importers
msgid "CDN host name"
msgstr "Имя хоста CDN"

#: includes/importers
msgid "CDN: W3 Total Cache uploads your files to the CDN; WPOptimizing only points file addresses at a CDN host. Set the host in WPOptimizing's CDN settings."
msgstr "CDN: W3 Total Cache загружает ваши файлы в CDN; WPOptimizing лишь направляет адреса файлов на хост CDN. Укажите хост в настройках CDN WPOptimizing."

#: includes/importers
msgid "Object Cache: W3 Total Cache kept it in files on disk, which WPOptimizing does not offer. Choose Redis, Memcached or APCu in Cache › Object cache if the server has one."
msgstr "Объектный кеш: W3 Total Cache хранил его в файлах на диске, чего WPOptimizing не предлагает. Выберите Redis, Memcached или APCu в разделе «Кеш › Объектный кеш», если они есть на сервере."

#: includes/importers
msgid "Database Cache"
msgstr "Кеш базы данных"

#: includes/importers
msgid "Cache Timeout"
msgstr "Время жизни кеша"

#: includes/importers
msgid "Rejected URL Strings"
msgstr "Отклонённые строки URL"

#: includes/importers
msgid "Tracking Parameters"
msgstr "Параметры отслеживания"

#: includes/importers
msgid "Compress pages so they’re served more quickly to visitors."
msgstr "Сжимать страницы, чтобы быстрее отдавать их посетителям."

#: includes/importers
msgid "Mobile device support"
msgstr "Поддержка мобильных устройств"

#: includes/importers
msgid "Preload mode"
msgstr "Режим предзагрузки"

#: includes/importers
msgid "Enable caching for all visitors."
msgstr "Включить кеширование для всех посетителей."

#: includes/importers
msgid "Disable caching for visitors who have a cookie set in their browser: WPOptimizing does cache visitors with ordinary cookies, and skips only logged-in users and the cookies you list."
msgstr "Отключить кеширование для посетителей с cookie в браузере: WPOptimizing кеширует посетителей с обычными cookie и исключает только вошедших пользователей и указанные вами cookie."

#: includes/importers
#, php-format
msgid "Do not cache the following page types (%s): not imported; WPOptimizing cannot leave out whole page types. Add their addresses to the URLs that are never cached if you need to."
msgstr "Не кешировать следующие типы страниц (%s): не импортировано; WPOptimizing не может исключать целые типы страниц. При необходимости добавьте их адреса в URL, которые никогда не кешируются."

#: includes/importers
msgid "Cache Delivery Method «Expert»: WP Super Cache serves pages straight from rules in .htaccess. After deactivating it, check that the block between «BEGIN WPSuperCache» and «END WPSuperCache» is gone, or visitors will keep getting its old pages."
msgstr "Способ выдачи кеша «Эксперт»: WP Super Cache отдаёт страницы напрямую по правилам в .htaccess. После его отключения проверьте, что блок между «BEGIN WPSuperCache» и «END WPSuperCache» исчез, иначе посетители будут получать его старые страницы."

#: includes/importers
msgid "Enable CDN Support"
msgstr "Включить поддержку CDN"

#: includes/importers
msgid "Off-site URL"
msgstr "Внешний URL"

#: includes/importers
msgid "Include directories"
msgstr "Включаемые каталоги"

#: includes/importers
msgid "Additional CNAMES"
msgstr "Дополнительные CNAME"

#: includes/importers
msgid "Timeout Rules: a rule for some pages only, or at a fixed time of day, was not imported. WPOptimizing has one lifetime for every page."
msgstr "Правила истечения: правило только для некоторых страниц или на фиксированное время суток не импортировано. В WPOptimizing одно время жизни для всех страниц."

#: includes/importers
msgid "Timeout Rules"
msgstr "Правила истечения"

#: includes/importers
msgid "Mobile"
msgstr "Мобильные"

#: includes/importers
msgid "Mobile: WP Fastest Cache did not cache pages for phones at all; WPOptimizing caches them, in a copy of their own."
msgstr "Мобильные: WP Fastest Cache вообще не кешировал страницы для телефонов; WPOptimizing кеширует их в отдельной копии."

#: includes/importers
msgid "Logged-in Users"
msgstr "Вошедшие пользователи"

#: includes/importers
msgid "Gzip"
msgstr "Gzip"

#: includes/importers
msgid "Widget Cache"
msgstr "Кеш виджетов"

#: includes/importers
msgid "Exclude Pages"
msgstr "Исключить страницы"

#: includes/importers
msgid "Exclude Cookies"
msgstr "Исключить cookie"

#: includes/importers
msgid "Exclude User-Agents"
msgstr "Исключить user agent"

#: includes/importers
msgid "Exclude CSS / Exclude JS"
msgstr "Исключить CSS / Исключить JS"

#: includes/importers
msgid "Exclude Pages (Google Analytics, Google Ads, Facebook and Yandex click IDs): not imported on purpose. WPOptimizing ignores those parameters and serves the cached page, which is faster and does not affect tracking."
msgstr "Исключить страницы (идентификаторы кликов Google Analytics, Google Ads, Facebook и Yandex): намеренно не импортировано. WPOptimizing игнорирует эти параметры и отдаёт кешированную страницу, что быстрее и не мешает аналитике."

#: includes/importers
msgid "Exclude Pages (home page, categories, tags, posts, pages, archives, attachments): not imported; WPOptimizing cannot leave out whole page types. Add their addresses to the URLs that are never cached if you need to."
msgstr "Исключить страницы (главная, рубрики, метки, записи, страницы, архивы, вложения): не импортировано; WPOptimizing не может исключать целые типы страниц. При необходимости добавьте их адреса в URL, которые никогда не кешируются."

#: includes/importers
msgid "Minify Css"
msgstr "Минификация CSS"

#: includes/importers
msgid "Minify Js"
msgstr "Минификация JS"

#: includes/importers
msgid "Render Blocking Js"
msgstr "JS, блокирующий отрисовку"

#: includes/importers
msgid "Delay Js"
msgstr "Задержка JS"

#: includes/importers
#, php-format
msgid "%s: they need WP Fastest Cache Premium, which is not installed here, so they were not acting and were not imported."
msgstr "%s: для них нужен WP Fastest Cache Premium, который здесь не установлен, поэтому они не работали и не импортированы."

#: includes/importers
msgid "Lazy Load Exclude Sources"
msgstr "Отложенная загрузка › Исключить источники"

#: includes/importers
msgid "Render Blocking Js › CSS: not imported. If you want it, switch on «Load CSS asynchronously» in WPOptimizing once its critical CSS is generated."
msgstr "JS, блокирующий отрисовку › CSS: не импортировано. Если нужно, включите «Асинхронная загрузка CSS» в WPOptimizing после того, как будет сгенерирован критический CSS."

#: includes/importers
msgid "Combine Css"
msgstr "Объединение CSS"

#: includes/importers
msgid "Combine Js"
msgstr "Объединение JS"

#: includes/importers
msgid "Combine Js Plus"
msgstr "Объединение JS Plus"

#: includes/importers
msgid "CDN Url"
msgstr "URL CDN"

#: includes/importers
msgid "CDN: the file types and keywords that chose which files go to the CDN were not imported; WPOptimizing sends the uploads, theme, plugin and WordPress files."
msgstr "CDN: типы файлов и ключевые слова, определявшие, какие файлы идут через CDN, не импортированы; WPOptimizing направляет загрузки, а также файлы темы, плагинов и WordPress."

#: includes/importers
msgid "Database Cleanup › Auto Cleanup"
msgstr "Очистка базы данных › Автоочистка"

#: includes/importers
msgid "Database Cleanup: WP Fastest Cache deleted every revision and every transient. WPOptimizing keeps the last two revisions of each post and deletes only expired transients; you can change both in General cleanup."
msgstr "Очистка базы данных: WP Fastest Cache удалял все ревизии и все транзиенты. WPOptimizing сохраняет две последние ревизии каждой записи и удаляет только просроченные транзиенты; и то и другое можно изменить в «Общей очистке»."

#: includes/admin/trait-cache.php
msgid "The web server did not answer from the cache, so pages keep being served through PHP. Check that the rules are in place and that the site can reach itself."
msgstr "Веб-сервер не ответил из кэша, поэтому страницы по-прежнему отдаются через PHP. Проверьте, что правила добавлены и сайт может обращаться сам к себе."

#: includes/admin/trait-cache.php
msgid "These lines are in the server's configuration: serve cached pages straight from the web server"
msgstr "Эти строки добавлены в конфигурацию сервера: отдавать кэшированные страницы напрямую веб-сервером"

#: includes/admin/trait-performance.php
msgid "Only the scripts in my list"
msgstr "Только скрипты из моего списка"

#: includes/admin/trait-performance.php
msgid "Nothing is delayed except the scripts you list in \"Also delay these\" below. Useful to keep the list you used with another plugin."
msgstr "Ничего не откладывается, кроме скриптов, указанных ниже в поле «Откладывать также эти». Удобно, чтобы сохранить список, который вы использовали в другом плагине."

#: includes/admin/trait-performance.php
msgid "The page cache settings changed and the lines in the server's configuration no longer match them, so pages are served through PHP again. Replace them with these and tick the box below."
msgstr "Настройки кэша страниц изменились, и строки в конфигурации сервера им больше не соответствуют, поэтому страницы снова отдаются через PHP. Замените их этими и отметьте флажок ниже."

#: includes/admin/trait-performance.php
#, php-format
msgid "%1$s: not switched on. The other plugin sent only some files to %2$s (by folder, file type or exclusion list), and WPOptimizing's CDN cannot be limited that way. If that host can serve every static file of the site, set it up in WPOptimizing's CDN settings."
msgstr "%1$s: не включено. Другой плагин отправлял на %2$s только часть файлов (по папке, типу файла или списку исключений), а CDN WPOptimizing так ограничить нельзя. Если этот хост может отдавать все статические файлы сайта, настройте его в параметрах CDN WPOptimizing."

#: includes/admin/trait-cache.php
msgid "Page types"
msgstr "Типы страниц"

#: includes/admin/trait-cache.php
msgid "Pages of the kinds ticked here are never cached. Saving empties the whole cache, so copies already stored stop being served at once."
msgstr "Страницы отмеченных здесь типов никогда не кэшируются. При сохранении весь кэш очищается, и уже сохранённые копии сразу перестают отдаваться."

#: includes/admin/trait-cache.php
msgid "Posts page (the blog listing, when it is not the front page)"
msgstr "Страница записей (лента блога, если это не главная страница)"

#: includes/admin/trait-cache.php
msgid "Archives: categories, tags, authors, dates, custom taxonomies and content type listings"
msgstr "Архивы: рубрики, метки, авторы, даты, собственные таксономии и списки типов содержимого"

#: includes/admin/trait-cache.php
msgid "Second and later pages of any listing"
msgstr "Вторая и последующие страницы любого списка"

#: includes/admin/trait-cache.php
msgid "Never cache single pages of these content types"
msgstr "Никогда не кэшировать отдельные страницы этих типов содержимого"

#: includes/admin/trait-cache.php
msgid "HTML minification"
msgstr "Минификация HTML"

#: includes/admin/trait-cache.php
msgid "Removes ordinary HTML comments, spaces at the end of lines and repeated empty lines from the cached copy. The spaces between tags, attributes, scripts, styles and preformatted text are never touched, and the page is stored as it was if anything looks unusual."
msgstr "Удаляет из кэшированной копии обычные HTML-комментарии, пробелы в конце строк и повторяющиеся пустые строки. Пробелы между тегами, атрибуты, скрипты, стили и предварительно отформатированный текст никогда не затрагиваются, а если что-то выглядит необычно, страница сохраняется как есть."

#: includes/admin/trait-cache.php
msgid "Minify the HTML of cached pages"
msgstr "Минифицировать HTML кэшированных страниц"

#: includes/admin/trait-cache.php
msgid "Keep HTML comments containing"
msgstr "Сохранять HTML-комментарии, содержащие"

#: includes/admin/trait-cache.php
msgid "part of the comment, e.g. ko foreach"
msgstr "часть комментария, например ko foreach"

#: includes/admin/trait-cache.php
msgid "Conditional comments, comments starting with <code>&lt;!--!</code> and anything between <code>&lt;!--noptimize--&gt;</code> and <code>&lt;!--/noptimize--&gt;</code> are always kept. One entry per line."
msgstr "Условные комментарии, комментарии, начинающиеся с <code>&lt;!--!</code>, и всё, что находится между <code>&lt;!--noptimize--&gt;</code> и <code>&lt;!--/noptimize--&gt;</code>, сохраняются всегда. Одна запись на строку."

#: includes/admin/trait-performance.php
msgid "Heartbeat by area"
msgstr "Heartbeat по областям"

#: includes/admin/trait-performance.php
msgid "How often the browser calls admin-ajax.php in each area. In the editor it is autosave and the edit lock, so it can be slowed (up to 120 seconds, before locks expire) but not switched off."
msgstr "Как часто браузер обращается к admin-ajax.php в каждой области. В редакторе это автосохранение и блокировка редактирования, поэтому его можно замедлить (до 120 секунд, пока блокировки не истекли), но не выключить."

#: includes/admin/trait-performance.php
msgid "Admin screens"
msgstr "Экраны админки"

#: includes/admin/trait-performance.php
msgid "Editor (posts, pages and Site Editor)"
msgstr "Редактор (записи, страницы и редактор сайта)"

#: includes/admin/trait-performance.php
msgid "Front end (logged-in users)"
msgstr "Публичная часть (вошедшие пользователи)"

#. translators: %d: number of seconds between two Heartbeat requests.
#: includes/admin/trait-performance.php
#, php-format
msgid "Every %d seconds"
msgstr "Каждые %d с"

#: includes/admin/trait-settings.php
msgid "Also outside the content — header, sidebars, footer — on pages saved by the page cache"
msgstr "Также вне контента — шапка, боковые панели, подвал — на страницах, сохранённых кэшем страниц"

#: includes/admin/trait-settings.php
msgid "Give the first image of the content high fetch priority (the likely LCP image); it is never lazy-loaded"
msgstr "Давать высокий приоритет загрузки первому изображению контента (вероятному изображению LCP); оно никогда не загружается отложенно"

#: includes/admin/trait-settings.php
msgid "Images never lazy-loaded at the top of the page"
msgstr "Изображения в верхней части страницы, которые никогда не загружаются отложенно"

#: includes/admin/trait-settings.php
msgid "Automatic (the first image of the content; the first three of the whole page)"
msgstr "Автоматически (первое изображение контента; первые три на всей странице)"

#: includes/admin/trait-settings.php
msgid "Never lazy-load images whose class or file name contains (one per line)"
msgstr "Никогда не загружать отложенно изображения, класс или имя файла которых содержит (по одному в строке)"

#: includes/admin/trait-settings.php
msgid "A fixed number counts the images of the whole page from the top, header included. Images with the <code>skip-lazy</code> or <code>no-lazy</code> class, or the <code>data-skip-lazy</code> or <code>data-no-lazy</code> attribute, are never lazy-loaded either; an image already marked <code>loading=\"lazy\"</code> keeps it and is not given priority."
msgstr "Фиксированное число отсчитывает изображения всей страницы сверху, включая шапку. Изображения с классом <code>skip-lazy</code> или <code>no-lazy</code> либо с атрибутом <code>data-skip-lazy</code> или <code>data-no-lazy</code> тоже никогда не загружаются отложенно; изображение, уже помеченное <code>loading=\"lazy\"</code>, сохраняет его и не получает приоритета."

#. translators: %s: the setting's name in the other plugin.
#: includes/importers/importer.php
#, php-format
msgid "%s: one area could not be copied as it was. WPOptimizing never switches the Heartbeat off in the editor, where it autosaves drafts and keeps the edit lock, and keeps intervals between 15 seconds and 120 (editor) or 300 (elsewhere); the nearest of those was set. Check Performance › Server."
msgstr "%s: одну из областей не удалось перенести как есть. WPOptimizing никогда не выключает Heartbeat в редакторе, где он автоматически сохраняет черновики и удерживает блокировку редактирования, и держит интервалы от 15 секунд до 120 (редактор) или 300 (остальные области); установлено ближайшее допустимое значение. Проверьте раздел Производительность › Сервер."

#. translators: 1: the setting's name in the other plugin, 2: the entries left out.
#: includes/importers/importer.php
#, php-format
msgid "%1$s: WPOptimizing excludes images by a part of their class or file name; these entries name another attribute and were not imported: %2$s"
msgstr "%1$s: WPOptimizing исключает изображения по части их класса или имени файла; эти записи относятся к другому атрибуту и не импортированы: %2$s"

#. translators: %s: the setting's name in the other plugin.
#: includes/importers/source-perfmatters.php
#, php-format
msgid "%s: not imported; WPOptimizing excludes an image by its own class or file name, not by the element around it. Add the images' class or file name to its lazy-load exclusions."
msgstr "%s: не импортировано; WPOptimizing исключает изображение по его собственному классу или имени файла, а не по окружающему элементу. Добавьте класс или имя файла этих изображений в его исключения отложенной загрузки."

#: includes/importers/source-perfmatters.php
msgid "Exclude Leading Images"
msgstr "Exclude Leading Images"

#: includes/importers/source-perfmatters.php
msgid "Exclude by Parent Selector"
msgstr "Exclude by Parent Selector"

#. translators: %s: the setting's name in the other plugin.
#: includes/importers/source-flyingpress.php
#, php-format
msgid "%s: the excluded images are not deferred, but they no longer all get high fetch priority; WPOptimizing gives it only to the likely LCP image."
msgstr "%s: исключённые изображения не загружаются отложенно, но высокий приоритет загрузки получают уже не все; WPOptimizing даёт его только вероятному изображению LCP."

#: includes/importers/source-flyingpress.php
msgid "Media Exclusions"
msgstr "Media Exclusions"

#. translators: %s: the other plugin's setting.
#: includes/importers/source-litespeed.php includes/importers/source-siteground.php
#, php-format
msgid "%s: not imported; WPOptimizing excludes images by their own class or file name only."
msgstr "%s: не импортировано; WPOptimizing исключает изображения только по их собственному классу или имени файла."

#: includes/importers/source-wp-rocket.php
msgid "Excluded images or iframes"
msgstr "Excluded images or iframes"

#: includes/importers/source-litespeed.php
msgid "Lazy Load Image Class Name Excludes"
msgstr "Lazy Load Image Class Name Excludes"

#: includes/importers/source-litespeed.php
msgid "Lazy Load Image Parent Class Name Excludes"
msgstr "Lazy Load Image Parent Class Name Excludes"

#: includes/importers/source-litespeed.php
msgid "Lazy Load URI Excludes"
msgstr "Lazy Load URI Excludes"

#: includes/admin/trait-cache.php
msgid "Hit diagnostics"
msgstr "Диагностика попаданий"

#: includes/admin/trait-cache.php
msgid "Counts how each request was answered and, when a page was not served from the cache, why. Off by default: while it is on, every request PHP handles adds one byte to a counter file."
msgstr "Подсчитывает, как был обработан каждый запрос, и, если страница не была отдана из кэша, — почему. По умолчанию выключено: пока оно включено, каждый запрос, который обрабатывает PHP, добавляет один байт в файл-счётчик."

#: includes/admin/trait-cache.php
msgid "Count cache hits and the reasons for misses"
msgstr "Считать попадания в кэш и причины промахов"

#: includes/admin/trait-cache.php
msgid "Hits seen by PHP: pages the web server sends without PHP and pages served by a CDN never reach these counters, so the real share of hits is higher. The share is hits, stale copies and 304 answers over the requests a page cache can answer: the preload's own visits, logged-in users, the admin, files that are not pages and methods other than GET are counted apart."
msgstr "Попадания, которые видит PHP: страницы, которые веб-сервер отдаёт без PHP, и страницы, отданные CDN, до этих счётчиков не доходят, поэтому реальная доля попаданий выше. Доля — это попадания, устаревшие копии и ответы 304 относительно запросов, на которые может ответить кэш страниц: собственные визиты предзагрузки, вошедшие пользователи, панель администратора, файлы, не являющиеся страницами, и методы, отличные от GET, считаются отдельно."

#: includes/admin/trait-cache.php
msgid "No requests counted yet."
msgstr "Запросы ещё не подсчитаны."

#: includes/admin/trait-cache.php
msgid "Hit rate, last 24 hours"
msgstr "Доля попаданий, последние 24 часа"

#: includes/admin/trait-cache.php
msgid "Hit rate, last 7 days"
msgstr "Доля попаданий, последние 7 дней"

#: includes/admin/trait-cache.php
msgid "Outcome"
msgstr "Результат"

#: includes/admin/trait-cache.php
msgid "Last 24 hours"
msgstr "Последние 24 часа"

#: includes/admin/trait-cache.php
msgid "Last 7 days"
msgstr "Последние 7 дней"

#: includes/admin/trait-cache.php
msgid "Paths that miss most (estimate)"
msgstr "Пути с наибольшим числом промахов (оценка)"

#: includes/admin/trait-cache.php
msgid "Estimated from one miss in every 20, so small numbers are rough. Only the path is recorded, never the query string."
msgstr "Оценка по одному промаху из каждых 20, поэтому небольшие числа приблизительны. Записывается только путь, параметры запроса — никогда."

#: includes/admin/trait-cache.php
msgid "Path"
msgstr "Путь"

#: includes/admin/trait-cache.php
msgid "Estimated misses"
msgstr "Промахи (оценка)"

#: includes/admin/trait-cache.php
msgid "Served from the cache (HIT)"
msgstr "Отдано из кэша (HIT)"

#: includes/admin/trait-cache.php
msgid "Served an expired copy while it was rebuilt (STALE)"
msgstr "Отдана устаревшая копия, пока она пересобиралась (STALE)"

#: includes/admin/trait-cache.php
msgid "Browser copy still valid (304)"
msgstr "Копия в браузере ещё действительна (304)"

#: includes/admin/trait-cache.php
msgid "Rendered and stored (MISS)"
msgstr "Сформировано и сохранено (MISS)"

#: includes/admin/trait-cache.php
msgid "HEAD request with no copy yet"
msgstr "Запрос HEAD, копии ещё нет"

#: includes/admin/trait-cache.php
msgid "Preload visits (not part of the share)"
msgstr "Визиты предзагрузки (не входят в долю)"

#: includes/admin/trait-cache.php
msgid "Not cached: method other than GET or HEAD"
msgstr "Не кэшировано: метод, отличный от GET или HEAD"

#: includes/admin/trait-cache.php
msgid "Not cached: logged-in user"
msgstr "Не кэшировано: вошедший пользователь"

#: includes/admin/trait-cache.php
msgid "Not cached: cookie that prevents caching (cart, password, commenter or your own list)"
msgstr "Не кэшировано: cookie, запрещающий кэширование (корзина, пароль, комментатор или ваш собственный список)"

#: includes/admin/trait-cache.php
msgid "Not cached: excluded browser or bot"
msgstr "Не кэшировано: исключённый браузер или бот"

#: includes/admin/trait-cache.php
msgid "Not cached: dynamic file (wp-cron.php, admin-ajax.php, sitemaps…)"
msgstr "Не кэшировано: динамический файл (wp-cron.php, admin-ajax.php, карты сайта…)"

#: includes/admin/trait-cache.php
msgid "Not cached: excluded URL (feeds, REST API or your own list)"
msgstr "Не кэшировано: исключённый URL (ленты, REST API или ваш собственный список)"

#: includes/admin/trait-cache.php
msgid "Not cached: query string not allowed"
msgstr "Не кэшировано: недопустимые параметры запроса"

#: includes/admin/trait-cache.php
msgid "Not cached: host name this site does not answer to"
msgstr "Не кэшировано: имя хоста, на которое этот сайт не отвечает"

#: includes/admin/trait-cache.php
msgid "Not cached: currency or country cookie with an unknown value"
msgstr "Не кэшировано: cookie валюты или страны с неизвестным значением"

#: includes/admin/trait-cache.php
msgid "Not cached: the page was sent in pieces before it ended"
msgstr "Не кэшировано: страница отправлялась частями до своего завершения"

#: includes/admin/trait-cache.php
msgid "Not cached: admin screen"
msgstr "Не кэшировано: экран администрирования"

#: includes/admin/trait-cache.php
msgid "Not cached: page not found"
msgstr "Не кэшировано: страница не найдена"

#: includes/admin/trait-cache.php
msgid "Not cached: search results"
msgstr "Не кэшировано: результаты поиска"

#: includes/admin/trait-cache.php
msgid "Not cached: feed"
msgstr "Не кэшировано: лента"

#: includes/admin/trait-cache.php
msgid "Not cached: the page asked not to be cached (DONOTCACHEPAGE)"
msgstr "Не кэшировано: страница попросила не кэшировать её (DONOTCACHEPAGE)"

#: includes/admin/trait-cache.php
msgid "Not cached: excluded page"
msgstr "Не кэшировано: исключённая страница"

#: includes/admin/trait-cache.php
msgid "Not cached: excluded page type"
msgstr "Не кэшировано: исключённый тип страницы"

#: includes/admin/trait-cache.php
msgid "Not cached: the response sets a cookie"
msgstr "Не кэшировано: ответ устанавливает cookie"

#: includes/admin/trait-cache.php
msgid "Not cached: the response forbids shared caches (private or no-store)"
msgstr "Не кэшировано: ответ запрещает общие кэши (private или no-store)"

#: includes/admin/trait-cache.php
msgid "Not cached: HTTP status other than 200"
msgstr "Не кэшировано: HTTP-статус, отличный от 200"

#: includes/admin/trait-cache.php
msgid "Not cached: not a complete HTML page"
msgstr "Не кэшировано: не полная HTML-страница"

#: includes/admin/trait-cache.php
msgid "Not cached: the settings changed while the page was rendered"
msgstr "Не кэшировано: настройки изменились во время формирования страницы"

#: includes/admin/trait-cache.php
msgid "Not cached: too many currency copies of the same URL"
msgstr "Не кэшировано: слишком много копий одного URL для разных валют"

#: includes/admin/trait-cache.php
msgid "Not cached: other reason"
msgstr "Не кэшировано: другая причина"

#: includes/admin/trait-cache.php
msgid "Pages found in the sitemap"
msgstr "Страницы, найденные в карте сайта"

#: includes/admin/trait-cache.php
msgid "Pages that could not be preloaded"
msgstr "Страницы, которые не удалось предзагрузить"

#. translators: 1: page address, 2: HTTP status code (0 when there was no answer).
#: includes/admin/trait-cache.php
#, php-format
msgid "%1$s (HTTP %2$s)"
msgstr "%1$s (HTTP %2$s)"

#: includes/admin/trait-cache.php
msgid "Also preload the pages listed in the site's sitemap"
msgstr "Также предзагружать страницы из карты сайта"

#. translators: %s: number of requests.
#: includes/admin/trait-cache.php
#, php-format
msgid "%s request"
msgid_plural "%s requests"
msgstr[0] "%s запрос"
msgstr[1] "%s запроса"
msgstr[2] "%s запросов"

#: includes/admin/trait-cache.php
msgid "The web server did not answer from the cache, so pages keep being served through PHP. Check that the rules are in place, that Apache has mod_headers (it is needed to tell browsers not to keep the pages) and that the site can reach itself."
msgstr "Веб-сервер не ответил из кэша, поэтому страницы по-прежнему отдаются через PHP. Проверьте, что правила добавлены, что в Apache есть mod_headers (он нужен, чтобы браузеры не сохраняли страницы) и что сайт может обращаться сам к себе."

#: includes/admin/trait-cache.php
msgid "The web server answers from the cached file directly, without starting PHP: faster pages and far more visitors at once on the same server. Only pages that need nothing from PHP are served this way (no currency, query string or security headers sent from PHP; phones get their own copy when it is on); the rest keep going through PHP as now."
msgstr "Веб-сервер отвечает прямо из файла в кэше, не запуская PHP: страницы быстрее, а один сервер выдерживает гораздо больше одновременных посетителей. Так отдаются только страницы, которым ничего не нужно от PHP (без валюты, параметров запроса и заголовков безопасности, отправляемых из PHP; мобильные получают свою копию, если она включена); остальные по-прежнему проходят через PHP."

#: includes/admin/trait-cache.php
msgid "Not cached: the page was purged while it was rendered"
msgstr "Не кэшировано: страница была очищена во время генерации"

#: includes/admin/trait-cache.php
msgid "WP-Cron is running late: a scheduled task has been waiting for more than 10 minutes. WP-Cron depends on visits that reach WordPress, and most visits are now answered from the cache. Set a system cron that calls wp-cron.php every minute."
msgstr "WP-Cron отстаёт: запланированная задача ждёт уже более 10 минут. WP-Cron зависит от посещений, которые доходят до WordPress, а большинство посещений теперь обслуживается из кэша. Настройте системный cron, который будет вызывать wp-cron.php каждую минуту."

#: includes/admin/trait-cache.php
msgid "Hosting cache"
msgstr "Кэш хостинга"

#: includes/admin/trait-cache.php
msgid "WPOptimizing purges your host’s page cache when content changes and when the whole site does (theme, menus, updates, “Flush all caches”), even with its own page cache off. Hosts that can only empty everything are emptied only for site-wide changes."
msgstr "WPOptimizing очищает кэш страниц вашего хостинга при изменении содержимого и при изменениях всего сайта (тема, меню, обновления, «Очистить все кэши»), даже если его собственный кэш страниц выключен. Хостинги, которые умеют только очищать всё сразу, очищаются только при изменениях всего сайта."

#: includes/admin/trait-cache.php
msgid "Page lifetime"
msgstr "Срок жизни страниц"

#: includes/admin/trait-cache.php
msgid "How long a cached page is served before it is built again. Forms, «add to cart» and many buttons carry WordPress security tokens that stop working after 12 to 24 hours, so pages are never kept longer than 12 hours: older copies would show forms and buttons that fail. Saving empties the cache."
msgstr "Как долго страница отдаётся из кэша, прежде чем будет создана заново. Формы, кнопка «В корзину» и многие другие кнопки содержат токены безопасности WordPress, которые перестают действовать через 12–24 часа, поэтому страницы никогда не хранятся дольше 12 часов: более старые копии показывали бы неработающие формы и кнопки. При сохранении кэш очищается."

#: includes/admin/trait-cache.php
msgid "Rebuild cached pages after"
msgstr "Пересоздавать страницы в кэше через"

#. translators: %d: number of hours.
#: includes/admin/trait-cache.php
#, php-format
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d час"
msgstr[1] "%d часа"
msgstr[2] "%d часов"

#. translators: 1: filter name, 2: lifetime in hours (may have decimals), or 0 for never.
#: includes/admin/trait-cache.php
#, php-format
msgid "Code on this site changes it through the %1$s filter: pages are kept for %2$s hours (0 means they never expire)."
msgstr "Код на этом сайте меняет это значение через фильтр %1$s: страницы хранятся %2$s ч (0 — бессрочно)."

#: includes/admin/trait-cache.php
msgid "Compression"
msgstr "Сжатие"

#: includes/admin/trait-cache.php
msgid "A compressed copy of each page is stored next to the normal one and sent to every browser that accepts it: smaller pages, sent faster, at no cost per visit. Turn it off only if the server already compresses pages on its own and something looks wrong."
msgstr "Рядом с обычной копией каждой страницы хранится сжатая, которая отдаётся всем браузерам, поддерживающим сжатие: страницы меньше, передаются быстрее, без затрат на каждое посещение. Отключайте это, только если сервер уже сам сжимает страницы и что-то работает не так."

#: includes/admin/trait-cache.php
msgid "Store compressed copies (gzip)"
msgstr "Хранить сжатые копии (gzip)"

#: includes/admin/trait-cache.php
msgid "Purge also these pages"
msgstr "Также очищать эти страницы"

#: includes/admin/trait-cache.php
msgid "Pages purged every time any page is purged, for example a page that lists the latest posts or products in a way WPOptimizing cannot see. They go to Cloudflare, Varnish and the hosting's cache too, also with the page cache off. One per line: a path or a full address of this site."
msgstr "Страницы, которые очищаются каждый раз при очистке любой страницы, например страница со списком последних записей или товаров, который WPOptimizing не может отследить. Они очищаются также в Cloudflare, в Varnish и в кэше хостинга, даже при выключенном кэше страниц. По одной в строке: путь или полный адрес этого сайта."

#: includes/admin/trait-cache.php
msgid "Purge also these URLs every time any page is purged"
msgstr "Также очищать эти URL при каждой очистке любой страницы"

#: includes/admin/trait-cache.php
msgid "e.g. /latest-news/"
msgstr "напр. /latest-news/"

#. translators: %s: list of the entries left out.
#: includes/admin/trait-cache.php
#, php-format
msgid "Page cache settings saved, except these addresses to purge too, which are not pages of this site: %s"
msgstr "Настройки кэша страниц сохранены, кроме этих адресов для дополнительной очистки — это не страницы этого сайта: %s"

#. translators: 1: whole hours set, 2: minutes the other plugin used.
#: includes/importers/importer.php
#, php-format
msgid "Page lifetime: WPOptimizing keeps pages for whole hours, from 1 to 12, so the other plugin's %2$d minutes became %1$d hour."
msgid_plural "Page lifetime: WPOptimizing keeps pages for whole hours, from 1 to 12, so the other plugin's %2$d minutes became %1$d hours."
msgstr[0] "Срок жизни страниц: WPOptimizing хранит страницы целыми часами, от 1 до 12, поэтому %2$d мин. другого плагина превратились в %1$d час."
msgstr[1] "Срок жизни страниц: WPOptimizing хранит страницы целыми часами, от 1 до 12, поэтому %2$d мин. другого плагина превратились в %1$d часа."
msgstr[2] "Срок жизни страниц: WPOptimizing хранит страницы целыми часами, от 1 до 12, поэтому %2$d мин. другого плагина превратились в %1$d часов."

#: includes/importers/source-wp-rocket.php
msgid "Always Purge URL(s)"
msgstr "Всегда очищать URL"

#. translators: %s: list of entries left out.
#: includes/importers/source-wp-rocket.php
#, php-format
msgid "Always Purge URL(s): these entries are patterns (or not pages of this site), which WPOptimizing does not purge, so they were not imported. Add the pages they meant one by one: %s"
msgstr "Всегда очищать URL: эти записи — шаблоны (или не страницы этого сайта), которые WPOptimizing не очищает, поэтому они не импортированы. Добавьте нужные страницы по одной: %s"

#: includes/admin/trait-cache.php
msgid "Also store Brotli copies (about 10–15% smaller than gzip)"
msgstr "Также сохранять копии Brotli (примерно на 10–15 % меньше, чем gzip)"

#: includes/admin/trait-cache.php
msgid "Sent to browsers that accept Brotli. Serving them without PHP on Nginx needs its brotli module."
msgstr "Отдаются браузерам, которые поддерживают Brotli. Чтобы отдавать их без PHP в Nginx, нужен его модуль brotli."

#. translators: %s: cache files and folders.
#: includes/admin/trait-cache.php
#, php-format
msgid "The web server cannot write to %s: no page is stored there until they belong to its user again."
msgstr "Веб-сервер не может записывать в %s: страницы там не сохраняются, пока они снова не будут принадлежать его пользователю."

#: includes/admin/trait-cache.php
msgid "Preload hints (experimental)"
msgstr "Подсказки предзагрузки (экспериментально)"

#: includes/admin/trait-cache.php
msgid "Each cached page is stored with up to three preload hints: its main image and up to two stylesheets from its head, so the browser can start downloading them before it reads the page. Cloudflare can turn them into 103 Early Hints if you switch Early Hints on there; other servers just send them with the page. Pages the web server sends without PHP go without them."
msgstr "Каждая кэшированная страница сохраняется с подсказками предзагрузки (не более трёх): её главное изображение и до двух таблиц стилей из её заголовка, чтобы браузер начал загружать их до того, как прочитает страницу. Cloudflare может превращать их в 103 Early Hints, если вы включите там Early Hints; другие серверы просто отправляют их вместе со страницей. Страницы, которые веб-сервер отдаёт без PHP, идут без них."

#: includes/admin/trait-cache.php
msgid "Send preload hints for the main image and stylesheets of cached pages"
msgstr "Отправлять подсказки предзагрузки для главного изображения и таблиц стилей кэшированных страниц"

#: includes
msgid "The page cache is not available for this site: its address cannot be used to name its cache files."
msgstr "Кэш страниц недоступен для этого сайта: его адрес нельзя использовать для именования файлов кэша."

#: includes
msgid "Not available on a multisite network yet: every site shares the same server rules, and each site has its own exclusions. Pages are served through PHP, from the cache."
msgstr "Пока недоступно в мультисайтовой сети: все сайты используют одни и те же правила сервера, а у каждого сайта свои исключения. Страницы отдаются через PHP из кэша."

#: includes
msgid "HTML at Cloudflare's edge is not available on a multisite network yet: its sites can share a Cloudflare zone, and one rule would cover them all."
msgstr "HTML на периферии Cloudflare пока недоступен в мультисайтовой сети: её сайты могут использовать одну зону Cloudflare, и одно правило охватило бы их все."

#. translators: %s: hours (may have decimals).
#: includes
#, php-format
msgid "WordPress security tokens on this site are only guaranteed for %s hours, less than pages are kept: forms and buttons on older pages may fail. Choose a shorter lifetime."
msgstr "На этом сайте токены безопасности WordPress гарантированно действуют только %s ч — меньше, чем хранятся страницы: формы и кнопки на более старых страницах могут не работать. Выберите меньший срок жизни."

#: includes
msgid "Visits from campaigns (utm_*, gclid, fbclid and the other parameters the page cache ignores) are served from the edge too: a Transform Rule takes those parameters off before Cloudflare looks for the page, only when they are the only ones. Analytics still sees them, because it reads the address in the browser. For this the token needs Zone › Transform Rules › Edit; without it, the edge works as before."
msgstr "Визиты из кампаний (utm_*, gclid, fbclid и другие параметры, которые кэш страниц игнорирует) тоже обслуживаются с периферии: Transform Rule удаляет эти параметры до того, как Cloudflare ищет страницу, но только если других параметров нет. Аналитика по-прежнему их видит, потому что читает адрес в браузере. Для этого токену нужно разрешение Zone › Transform Rules › Edit; без него периферия работает как раньше."

#: includes
msgid "Visits with campaign parameters are served from the edge too."
msgstr "Визиты с параметрами кампаний тоже обслуживаются с периферии."

#: includes
msgid "Campaign parameters are taken off at the edge, but a visit with one was not served from the edge yet. That is normal while it fills."
msgstr "Параметры кампаний удаляются на периферии, но визит с одним из них ещё не был обслужен с периферии. Это нормально, пока она заполняется."

#. translators: %s: error returned by Cloudflare.
#: includes
#, php-format
msgid "Visits with campaign parameters still reach your server: Cloudflare refused the Transform Rule (%s). Add Zone › Transform Rules › Edit to the token and press «Check now»."
msgstr "Визиты с параметрами кампаний по-прежнему доходят до вашего сервера: Cloudflare отклонил Transform Rule (%s). Добавьте токену Zone › Transform Rules › Edit и нажмите «Проверить сейчас»."

#: includes/admin/trait-plugin-rules.php
msgid "Never on the front end"
msgstr "Никогда на сайте"

#: includes/admin/trait-plugin-rules.php
msgid "Stop a plugin from loading where it does nothing — a contact form everywhere but the contact page, a shop plugin on the blog, an editor plugin (Classic Editor, Advanced Editor Tools) on every page with \"Never on the front end\". Its PHP, its queries and its CSS/JS all stay out. Only for visitors: logged-in users, the admin, AJAX, the REST API and cron always get every plugin."
msgstr "Не даёт плагину загружаться там, где он ничего не делает: форма обратной связи везде, кроме страницы контактов, плагин магазина в блоге, плагин редактора (Classic Editor, Advanced Editor Tools) на всех страницах с режимом «Никогда на сайте». Его PHP, запросы и CSS/JS остаются за бортом. Только для посетителей: вошедшие пользователи, админка, AJAX, REST API и cron всегда получают все плагины."

#: includes/admin/trait-performance.php
msgid "Load CSS asynchronously (non-blocking render; only on pages that have critical CSS, so they never paint unstyled)"
msgstr "Загружать CSS асинхронно (не блокирует отрисовку; только на страницах с критическим CSS, чтобы они никогда не показывались без стилей)"

#: includes/admin/trait-performance.php
msgid "The generated critical CSS files are no longer on the disk, so nothing is being inlined and asynchronous CSS stays off. Generate it again."
msgstr "Файлы сгенерированного критического CSS больше не на диске: ничего не встраивается, и асинхронный CSS остаётся выключенным. Сгенерируйте его заново."

#: includes/admin/trait-cache.php
msgid "Pages keep being served through PHP, from the cache, as before."
msgstr "Страницы по-прежнему отдаются через PHP из кэша, как раньше."

#: includes/admin/trait-cache.php
msgid "The web server does not have the mod_headers module enabled, and it is needed to tell browsers not to keep the pages. In cPanel: Software › EasyApache 4 › Apache Modules › mod_headers. In Plesk: Tools & Settings › Apache Web Server › headers. Or ask your host: «Please enable the Apache module mod_headers for my site»."
msgstr "На веб-сервере не включён модуль mod_headers, а он нужен, чтобы браузеры не сохраняли страницы. В cPanel: Software › EasyApache 4 › Apache Modules › mod_headers. В Plesk: Инструменты и настройки › Веб-сервер Apache › headers. Или попросите хостинг: «Пожалуйста, включите модуль Apache mod_headers для моего сайта»."

#: includes/admin/trait-cache.php
msgid "The web server refuses to read the cache folder (wp-content/cache/wpopt-page): a rule in the server's configuration or a security plugin closes it. Ask your host to allow reading the .html files in that folder."
msgstr "Веб-сервер не может читать папку кэша (wp-content/cache/wpopt-page): её закрывает правило в конфигурации сервера или плагин безопасности. Попросите хостинг разрешить чтение файлов .html в этой папке."

#: includes/admin/trait-cache.php
msgid "The site could not reach itself to check the rules (a firewall, a security plugin or the hosting blocks it). Ask your host to allow the site to make requests to its own address."
msgstr "Сайт не смог обратиться сам к себе, чтобы проверить правила (это блокирует файрвол, плагин безопасности или хостинг). Попросите хостинг разрешить сайту запросы к собственному адресу."

#: includes/admin/trait-cache.php
msgid "The web server is not applying the rules added to .htaccess (the hosting may not allow .htaccess overrides, or another rule answers first). Ask your host whether .htaccess rewrite rules are allowed for the site."
msgstr "Веб-сервер не применяет правила, добавленные в .htaccess (возможно, хостинг не разрешает .htaccess или раньше срабатывает другое правило). Спросите хостинг, может ли сайт использовать правила перезаписи в .htaccess."

#: includes/admin/trait-cache.php
msgid "Too many sites of this network serve their pages without PHP: the shared .htaccess would grow too long. This site keeps being served through PHP, from the cache."
msgstr "Слишком много сайтов этой сети отдают страницы без PHP: общий .htaccess стал бы слишком длинным. Этот сайт по-прежнему отдаётся через PHP из кэша."

#: includes/admin/trait-cache.php
msgid "On a multisite network this is only available with Apache or LiteSpeed. Pages keep being served through PHP, from the cache."
msgstr "В мультисайтовой сети это доступно только с Apache или LiteSpeed. Страницы по-прежнему отдаются через PHP из кэша."

#: includes/admin/trait-cache.php
msgid "On a multisite network this is only available with Apache or LiteSpeed. Pages are served through PHP, from the cache."
msgstr "В мультисайтовой сети это доступно только с Apache или LiteSpeed. Страницы отдаются через PHP из кэша."

#: includes/admin/trait-cache.php
msgid "On: the web server serves this site's cached pages. Only a network administrator can switch it off, because the rules are in the .htaccess shared by every site of the network."
msgstr "Включено: веб-сервер сам отдаёт сохранённые страницы этого сайта. Отключить это может только администратор сети, потому что правила находятся в .htaccess, общем для всех сайтов сети."

#: includes/admin/trait-cache.php
msgid "Off. Only a network administrator can switch it on, because the rules go into the .htaccess shared by every site of the network."
msgstr "Выключено. Включить это может только администратор сети, потому что правила записываются в .htaccess, общий для всех сайтов сети."

#: includes/admin/trait-cache.php
msgid "The .htaccess is shared by every site of the network: each site that switches this on gets its own block of rules, for its own address and with its own exclusions."
msgstr "Файл .htaccess общий для всех сайтов сети: каждый сайт, включивший это, получает собственный блок правил — для своего адреса и со своими исключениями."

#: includes/importers/source-litespeed.php
msgid "This site runs on a LiteSpeed web server, which serves LiteSpeed Cache's page cache before WordPress even loads. Its page cache settings were imported, but the WPOptimizing page cache stays off: switch LiteSpeed Cache's page cache off before you turn it on."
msgstr "Этот сайт работает на веб-сервере LiteSpeed, который отдаёт кэш страниц LiteSpeed Cache ещё до загрузки WordPress. Его настройки кэша страниц импортированы, но кэш страниц WPOptimizing остаётся выключенным: отключите кэш страниц LiteSpeed Cache, прежде чем включать его."

#: includes/importers/source-litespeed.php
msgid "Load CSS Asynchronously: LiteSpeed Cache gets its critical CSS from QUIC.cloud, which is not imported. WPOptimizing only loads CSS asynchronously on pages that have their own critical CSS, so generate it in WPOptimizing for this setting to take effect."
msgstr "Асинхронная загрузка CSS: LiteSpeed Cache получает критический CSS от QUIC.cloud, а он не импортируется. WPOptimizing загружает CSS асинхронно только на страницах со своим критическим CSS, поэтому сгенерируйте его в WPOptimizing, чтобы эта настройка заработала."

#: includes/admin/trait-cache.php
msgid "The web server answers from the cached file directly, without starting PHP: faster pages and far more visitors at once on the same server. Only pages that need nothing else from PHP are served this way (no currency or query string; security headers sent from PHP go with them when every page sends the same; phones get their own copy when it is on); the rest keep going through PHP as now."
msgstr "Веб-сервер отвечает сохранённым файлом напрямую, не запуская PHP: страницы быстрее, а один и тот же сервер выдерживает гораздо больше одновременных посетителей. Так отдаются только страницы, которым больше ничего не нужно от PHP (без валюты и параметров в адресе; заголовки безопасности, отправляемые PHP, отдаются вместе с ними, если все страницы отправляют одинаковые; для телефонов — своя копия, если она включена); остальное по-прежнему идёт через PHP."

#: includes/admin
msgid "Defer jQuery too (the inline code that uses it runs right after it; only with «Defer JavaScript» on)"
msgstr "Откладывать и jQuery (встроенный код, который его использует, выполняется сразу после него; только при включённом «Откладывать JavaScript»)"

#: includes/admin
msgid "jQuery is in the list of scripts not to defer, so it stays eager. Remove it from that list for this setting to take effect."
msgstr "jQuery есть в списке скриптов, которые не откладываются, поэтому он по-прежнему загружается сразу. Уберите его из этого списка, чтобы настройка заработала."

#: includes/admin
msgid "Also cache these REST API routes, for visitors who are not logged in (only routes whose answer is the same for everybody)"
msgstr "Кэшировать также эти маршруты REST API для посетителей без входа в систему (только маршруты, ответ которых одинаков для всех)"

#: includes/admin
msgid "route after /wp-json/, e.g. my-plugin/v1/settings"
msgstr "маршрут после /wp-json/, например my-plugin/v1/settings"

#: includes/importers/importer.php
msgid "%s has been deactivated (not deleted): its page cache no longer serves your pages. Switch on the WPOptimizing page cache in Speed › Cache; an import never switches it on by itself."
msgstr "%s деактивирован (не удалён): его кэш страниц больше не отдаёт ваши страницы. Включите кэш страниц WPOptimizing в разделе «Скорость › Кэш»; импорт никогда не включает его сам."

#: includes/importers/importer.php
msgid "LiteSpeed Cache cleans up after itself when it is deactivated: its rules in .htaccess, its object-cache.php and the WP_CACHE line in wp-config.php (WPOptimizing writes its own back if its page cache is installed). On a network it only does so when no other site still has it active."
msgstr "При деактивации LiteSpeed Cache убирает за собой: свои правила в .htaccess, свой object-cache.php и строку WP_CACHE в wp-config.php (WPOptimizing записывает свою обратно, если его кэш страниц установлен). В сети он делает это, только когда ни на одном другом сайте он больше не активен."

#: includes/importers/importer.php
msgid "Settings imported from %s. You can undo the import in Settings."
msgstr "Настройки импортированы из %s. Отменить импорт можно в настройках."

#: includes/importers/importer.php
msgid "%s was not deactivated: only a network administrator can do it, because it is active for the whole network."
msgstr "%s не деактивирован: это может сделать только администратор сети, так как он активен во всей сети."

#: includes/importers/importer.php
msgid "Import your current settings"
msgstr "Импортируйте текущие настройки"

#: includes/importers/importer.php
msgid "Another cache or performance plugin left its settings on this site. WPOptimizing can bring over what has an equivalent here, so you do not have to set it up again. The import is applied when the analysis starts, after the choices of the next steps, so what you bring over wins over their defaults. Passwords and API keys are never copied, the page cache and the object cache are never switched on by an import, and you can undo it in Settings."
msgstr "Другой плагин кэширования или производительности оставил свои настройки на этом сайте. WPOptimizing может перенести то, у чего здесь есть аналог, чтобы вам не пришлось настраивать всё заново. Импорт применяется при запуске анализа, после выбора на следующих шагах, поэтому перенесённое имеет приоритет над их значениями по умолчанию. Пароли и ключи API никогда не копируются, импорт никогда не включает кэш страниц или объектный кэш, и его можно отменить в настройках."

#: includes/importers/importer.php
msgid "Deactivate %s on the whole network after importing (it is not deleted)"
msgstr "Деактивировать %s во всей сети после импорта (он не удаляется)"

#: includes/importers/importer.php
msgid "Deactivate %s after importing (it is not deleted)"
msgstr "Деактивировать %s после импорта (он не удаляется)"

#: includes/importers/importer.php
msgid "%s is active for the whole network: only a network administrator can deactivate it."
msgstr "%s активен во всей сети: деактивировать его может только администратор сети."

#: includes/importers/importer.php
msgid "Do not import anything"
msgstr "Ничего не импортировать"

#: includes/importers/importer.php
msgid "Import the settings another cache or performance plugin left on each chosen site (after the profile, so they win over it; undo it in each site's Settings)"
msgstr "Импортировать настройки, оставленные другим плагином кэширования или производительности на каждом выбранном сайте (после профиля, поэтому они важнее; отменяется в настройках каждого сайта)"

#: includes/importers/importer.php
msgid "Then deactivate that plugin (not deleted): on its site, or on the whole network when it is network-active"
msgstr "Затем деактивировать этот плагин (не удаляется): на его сайте или во всей сети, если он активен в сети"

#: includes/admin/class-network-dashboard.php
msgid "Settings of another cache plugin imported on %d site; you can undo it in that site's Settings."
msgid_plural "Settings of another cache plugin imported on %d sites; you can undo it in each site's Settings."
msgstr[0] "Настройки другого плагина кэширования импортированы на %d сайте; отменить можно в настройках этого сайта."
msgstr[1] "Настройки другого плагина кэширования импортированы на %d сайтах; отменить можно в настройках каждого сайта."
msgstr[2] "Настройки другого плагина кэширования импортированы на %d сайтах; отменить можно в настройках каждого сайта."

#: includes/admin/class-network-dashboard.php
msgid "%d plugin deactivated (not deleted): its page cache no longer serves pages, so switch on the WPOptimizing page cache in each site's Speed › Cache; an import never switches it on by itself."
msgid_plural "%d plugins deactivated (not deleted): their page cache no longer serves pages, so switch on the WPOptimizing page cache in each site's Speed › Cache; an import never switches it on by itself."
msgstr[0] "%d плагин деактивирован (не удалён): его кэш страниц больше не отдаёт страницы, поэтому включите кэш страниц WPOptimizing в разделе «Скорость › Кэш» каждого сайта; импорт никогда не включает его сам."
msgstr[1] "%d плагина деактивированы (не удалены): их кэш страниц больше не отдаёт страницы, поэтому включите кэш страниц WPOptimizing в разделе «Скорость › Кэш» каждого сайта; импорт никогда не включает его сам."
msgstr[2] "%d плагинов деактивированы (не удалены): их кэш страниц больше не отдаёт страницы, поэтому включите кэш страниц WPOptimizing в разделе «Скорость › Кэш» каждого сайта; импорт никогда не включает его сам."

#: includes/admin/trait-cache.php
msgid "Also cache llms.txt, robots.txt, the XML sitemaps and Markdown copies generated by WordPress or a plugin (only kept when the answer is text or XML and the same for everybody, and purged with any content change)"
msgstr "Также кэшировать llms.txt, robots.txt, XML-карты сайта и Markdown-копии, которые создаёт WordPress или плагин (сохраняются, только если ответ — текст или XML, одинаковый для всех; очищаются при любом изменении содержимого)"

#: includes/admin/trait-cache.php
msgid "Also cache these text files generated by WordPress (only kept when the answer is text or XML and the same for everybody)"
msgstr "Также кэшировать эти текстовые файлы, создаваемые WordPress (сохраняются, только если ответ — текст или XML, одинаковый для всех)"

#: includes/admin/trait-cache.php
msgid "file name from the site's address, * for any characters, e.g. ai.txt"
msgstr "имя файла от адреса сайта, * — любые символы, например ai.txt"

#: includes/admin/class-admin-ui.php
msgid "Analytics never receives cookie consent"
msgstr "Analytics не получает согласие на cookies"

#. translators: 1: consent banner plugin, e.g. "Complianz"; 2: analytics plugin, e.g. "Google Analytics for WooCommerce".
#: includes/admin/class-admin-ui.php
#, php-format
msgid "%2$s only learns that visitors accepted cookies in %1$s through the WP Consent API plugin, which is not installed: Google receives every visit as without consent and they do not appear in Realtime."
msgstr "%2$s узнаёт, что посетители приняли cookies в %1$s, только через плагин WP Consent API, который не установлен: Google получает каждое посещение как без согласия, и они не видны в отчёте «В реальном времени»."

#: includes/admin/class-admin-ui.php
msgid "Install WP Consent API"
msgstr "Установить WP Consent API"

#: includes/admin/trait-performance.php
msgid "The design has changed: the critical CSS will be regenerated on its own in a few minutes, and the cached pages emptied."
msgstr "Дизайн изменился: критический CSS будет автоматически пересоздан через несколько минут, а кэшированные страницы будут очищены."

#: includes/admin/trait-performance.php
msgid "Once applied, it is regenerated on its own when the theme, its options, the Customizer, the global styles, the theme builder's layouts or the pages it was generated from change."
msgstr "После применения он пересоздаётся автоматически, когда меняются тема, её настройки, настройщик, глобальные стили, макеты конструктора темы или страницы, по которым он был создан."

#. translators: %s: human-readable time difference, e.g. "2 hours".
#: includes/admin/trait-performance.php
#, php-format
msgid "Last done %s ago."
msgstr "Последний раз — %s назад."

#: includes/cloudflare.php
#, php-format
msgid "The zone ID belongs to %s, not to this site."
msgstr "ID зоны принадлежит %s, а не этому сайту."

#: includes/cloudflare.php
#, php-format
msgid "That zone ID belongs to %1$s, not to %2$s. Nothing will be purged until you enter the zone ID of this domain."
msgstr "Этот ID зоны принадлежит %1$s, а не %2$s. Ничего не будет очищаться, пока вы не укажете ID зоны этого домена."

#: includes/cloudflare.php
#, php-format
msgid "The zone ID belongs to %s, not to this site, so nothing of this site is being purged. Enter the zone ID of this domain."
msgstr "ID зоны принадлежит %s, а не этому сайту, поэтому кеш этого сайта не очищается. Укажите ID зоны этого домена."

#: includes/cloudflare.php
#, php-format
msgid "This zone ID is also saved on %s. A Cloudflare zone is one domain, so one of the sites is purging the other's cache and not its own: check the zone ID on each."
msgstr "Этот ID зоны также сохранён на %s. Зона Cloudflare — это один домен, поэтому один из сайтов очищает кеш другого, а не свой: проверьте ID зоны на каждом."

#. translators: %s: the other plugin's name.
#: includes/importers/importer.php
#, php-format
msgid "In %s"
msgstr "В %s"

#: includes/importers/importer.php
msgid "In the other plugin"
msgstr "В другом плагине"

#: includes/importers/importer.php
msgid "In WPOptimizing"
msgstr "В WPOptimizing"

