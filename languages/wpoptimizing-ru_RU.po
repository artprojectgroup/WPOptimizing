#: includes/admin/trait-cron.php:289
msgid "WordPress scheduled tasks. An event whose hook has no registered callback is likely orphaned (left by an uninstalled plugin) and will never run — safe to remove. Active and WordPress-core events are protected."
msgstr "Запланированные задачи WordPress. Событие, у хука которого нет зарегистрированного обработчика, скорее всего осиротевшее (оставлено удалённым плагином) и никогда не выполнится — его можно безопасно удалить. Активные события и события ядра WordPress защищены."

#. translators: %d: number of orphaned cron events.
#: includes/admin/trait-cron.php:303
#, php-format
msgid "%d scheduled event looks orphaned (its hook has no callback)."
msgid_plural "%d scheduled events look orphaned (their hooks have no callback)."
msgstr[0] "%d запланированное событие выглядит осиротевшим (у его хука нет обратного вызова)."
msgstr[1] "%d запланированных события выглядят осиротевшими (у их хуков нет обратных вызовов)."
msgstr[2] "%d запланированных событий выглядят осиротевшими (у их хуков нет обратных вызовов)."

#: includes/admin/trait-cron.php:326
msgid "Search hooks"
msgstr "Поиск хуков"

#: includes/admin/trait-cron.php:332
msgid "Unschedule all"
msgstr "Отменить все"

#: includes/admin/trait-cron.php:333
