msgstr "Используется: медиатека (#%d)"

#: includes/admin/trait-media-audit.php:610
#: includes/admin/trait-media-audit.php:765
msgid "not identified"
msgstr "не определено"

#: includes/admin/trait-media-audit.php:611
msgid "Media library"
msgstr "Медиатека"

