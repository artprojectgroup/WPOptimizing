msgstr "Активный бэкенд"

#: includes/admin/trait-cache.php:1283
msgid "Available backends"
msgstr "Доступные бэкенды"

#: includes/admin/trait-cache.php:1296
msgid "Hits / misses (this request)"
msgstr "Попадания / промахи (этот запрос)"

#. translators: 1: hit count, 2: miss count, 3: hit ratio percentage.
