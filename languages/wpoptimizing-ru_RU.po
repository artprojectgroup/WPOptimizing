msgstr "%1$s попаданий · %2$s промахов · %3$d %% попаданий"

#: includes/admin/trait-cache.php:1321
msgid "Detected page caches"
msgstr "Обнаруженные кэши страниц"

#: includes/admin/trait-cache.php:1322
msgid "WPOptimizing detects your host or plugin page cache and purges it automatically after a cleanup (and from the toolbar “Flush all caches”), so visitors never see stale content. Its own page cache, in this tab, is optional and does not run alongside another one."
msgstr "WPOptimizing обнаруживает кэш страниц вашего хостинга или плагина и очищает его автоматически после очистки (и по кнопке «Очистить все кэши» на панели инструментов), чтобы посетители никогда не видели устаревший контент. Его собственный кэш страниц на этой вкладке необязателен и не работает одновременно с другим."

#: includes/admin/trait-cache.php:1325
msgid "Integration"
msgstr "Интеграция"

#: includes/admin/trait-cache.php:1328
msgid "Auto-purges on changes"
msgstr "Очищается автоматически при изменениях"

#: includes/admin/trait-cache.php:1329
msgid "Purged after cleanup and from the toolbar"
msgstr "Очищается после очистки и из панели инструментов"

#: includes/admin/trait-cache.php:1339
msgid "A newer version of the object cache drop-in is available. Update to get the latest fixes and backends."
msgstr "Доступна более новая версия drop-in кэша объектов. Обновите, чтобы получить последние исправления и бэкенды."

#: includes/admin/trait-cache.php:1354
msgid "Only a network administrator can enable or disable the object cache on this multisite network."
msgstr "Только администратор сети может включить или отключить кэш объектов в этой мультисайтовой сети."

#: includes/admin/trait-cache.php:1358 includes/admin/trait-cache.php:1812
msgid "Update drop-in"
msgstr "Обновить drop-in"

#: includes/admin/trait-cache.php:1361
msgid "Disable object cache"
msgstr "Отключить кэш объектов"

#: includes/admin/trait-cache.php:1363 includes/admin/trait-cache.php:1369
msgid "Flush cache now"
msgstr "Очистить кэш сейчас"

#: includes/admin/trait-cache.php:1365
msgid "Enable object cache"
msgstr "Включить кэш объектов"

#: includes/admin/trait-cache.php:1386
msgid "Serves a static HTML copy of each page to anonymous visitors, so most requests never boot WordPress — the single biggest speed win. Opt-in and off by default: logged-in users, carts, checkout, admin, feeds and any dynamic request are never cached, and the cache is purged automatically whenever content changes."
msgstr "Отдаёт анонимным посетителям статическую HTML-копию каждой страницы, поэтому большинство запросов вообще не запускают WordPress — самый большой выигрыш в скорости. Опционально и по умолчанию выключено: авторизованные пользователи, корзины, оформление заказа, админка, ленты и любые динамические запросы никогда не кэшируются, а кэш автоматически очищается при изменении контента."

#: includes/admin/trait-cache.php:1402
msgid "WP_CACHE constant"
msgstr "Константа WP_CACHE"

#: includes/admin/trait-cache.php:1403
msgid "Defined"
msgstr "Определена"

#: includes/admin/trait-cache.php:1403
msgid "Not defined"
msgstr "Не определена"

#. translators: %s: detected page-cache plugin names.
#: includes/admin/trait-cache.php:1414
#, php-format
msgid "Another page cache is active: %s. Disable it before enabling ours to avoid two caches fighting over the same page."
msgstr "Активен другой кэш страниц: %s. Отключите его перед включением нашего, чтобы два кэша не конфликтовали за одну страницу."

#: includes/admin/trait-cache.php:1430
msgid "Only a network administrator can manage the page cache on this multisite network."
msgstr "Только администратор сети может управлять кэшем страниц в этой мультисайт-сети."

#: includes/admin/trait-cache.php:1432
msgid "Disable page cache"
msgstr "Отключить кэш страниц"

#: includes/admin/trait-cache.php:1434
msgid "Clear page cache now"
msgstr "Очистить кэш страниц"

#: includes/admin/trait-cache.php:1436
msgid "Enable page cache"
msgstr "Включить кэш страниц"

#: includes/admin/trait-cache.php:1464
msgid "Rebuilds the cached pages in the background after they are cleared, so the next visitor gets the fast copy instead of waiting for WordPress. It visits a few pages at a time and waits while the server is busy."
msgstr "Пересобирает кэшированные страницы в фоне после очистки, чтобы следующий посетитель получил быструю копию, а не ждал WordPress. Обходит по нескольку страниц за раз и ждёт, пока сервер занят."

#: includes/admin/trait-cache.php:1467
msgid "Pages waiting"
msgstr "Страниц в очереди"

#: includes/admin/trait-cache.php:1471
msgid "Last run"
msgstr "Последний запуск"

#. translators: 1: date and time, 2: number of pages.
