#: includes/admin/trait-docs.php:537
#, php-format
msgid "Open the <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">PageSpeed Insights API</a> page and press “Enable”."
msgstr "打开 <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">PageSpeed Insights API</a> 页面并点击“启用”。"

#. translators: %s: link to the Google Cloud console credentials page.
#: includes/admin/trait-docs.php:544
#, php-format
msgid "Go to <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Credentials</a> and choose “Create credentials” → “API key”."
msgstr "进入 <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">凭据</a> 页面，选择“创建凭据”→“API 密钥”。"

#: includes/admin/trait-docs.php:548
msgid "Copy the key, paste it in the field above and save it. Restricting the key to the PageSpeed Insights API is recommended."
msgstr "复制密钥，粘贴到上方的字段中并保存。建议将该密钥限制为仅用于 PageSpeed Insights API。"

#. translators: %s: link to Google's official PageSpeed Insights documentation.
#: includes/admin/trait-docs.php:553
#, php-format
msgid "Official documentation: <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Get started with the PageSpeed Insights API</a>."
msgstr "官方文档：<a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">PageSpeed Insights API 入门</a>。"

