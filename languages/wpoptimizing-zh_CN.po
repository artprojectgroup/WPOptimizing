msgstr "请先输入许可证密钥。"

#: includes/admin/class-network-dashboard.php:964
msgid "Could not process the license request."
msgstr "无法处理许可证请求。"

#: includes/admin/class-network-dashboard.php:985
msgid "Schedule a fresh analysis on every site in the network?"
msgstr "为网络中的每个网站安排新的分析？"

#: includes/admin/class-network-dashboard.php:993
msgid "Network overview"
msgstr "网络概览"

#: includes/admin/class-network-dashboard.php:1010
msgid "Never analysed"
msgstr "从未分析"

#: includes/admin/class-network-dashboard.php:1011
msgid "Orphans (all sites)"
msgstr "孤立项（所有网站）"

#: includes/admin/class-network-dashboard.php:1012
msgid "To identify (all sites)"
msgstr "待识别（所有网站）"

