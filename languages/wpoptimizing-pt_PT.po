#, php-format
msgid "%s resumed."
msgstr "%s retomado."

#: includes/admin/trait-cron.php:508
msgid "By default WordPress runs scheduled tasks on visitor page loads: this adds latency to random requests and misses tasks on low-traffic sites. Disable WP-Cron and drive it from a real server cron instead for faster page loads and dependable scheduling."
msgstr "Por predefinição, o WordPress executa as tarefas agendadas nos carregamentos de página dos visitantes: isto acrescenta latência a pedidos aleatórios e falha tarefas em sites com pouco tráfego. Desative o WP-Cron e faça-o funcionar a partir de um cron real do servidor para carregamentos de página mais rápidos e um agendamento fiável."

#: includes/admin/trait-cron.php:513
msgid "WP-Cron disabled"
msgstr "WP-Cron desativado"

#: includes/admin/trait-cron.php:514
