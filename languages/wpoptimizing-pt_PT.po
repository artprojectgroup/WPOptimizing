msgstr "Mantém em memória as consultas dispendiosas da base de dados — o maior ganho no TTFB do servidor."

#: includes/admin/trait-performance.php:281
#: includes/admin/trait-performance.php:296
msgid "Enable now"
msgstr "Ativar agora"

#: includes/admin/trait-performance.php:291
