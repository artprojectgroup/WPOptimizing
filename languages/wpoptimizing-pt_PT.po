msgstr "Eliminar o(s) %d backup(s) selecionado(s)? É criada uma cópia de segurança primeiro."

#. translators: %d: number of filtered files.
#: includes/admin/trait-media.php:1812
#, php-format
msgid "Delete ALL %d filtered backup(s)? A backup is created first."
msgstr "Eliminar TODOS os %d backup(s) filtrado(s)? É criada uma cópia de segurança primeiro."

