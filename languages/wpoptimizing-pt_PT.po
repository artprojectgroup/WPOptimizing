msgstr "Adicione esta linha ao crontab do seu servidor para que as tarefas agendadas continuem a ser executadas a cada 5 minutos:"

#: includes/admin/trait-cron.php:530
msgid "Re-enable WP-Cron"
msgstr "Reativar o WP-Cron"

#: includes/admin/trait-cron.php:533
