#, php-format
msgid "%1$s, %2$s rows — %3$s"
msgstr "%1$s, %2$s linhas — %3$s"

#: includes/admin/trait-tables.php:560
msgid "A table can belong to a plugin that is working perfectly and still be the largest thing in your database — caches, logs and tracking tables are the usual ones. Check the plugin's own settings for a retention limit before deleting anything here."
msgstr "Uma tabela pode pertencer a um plugin que funciona perfeitamente e ainda assim ser a maior coisa na sua base de dados: caches, registos e tabelas de rastreio são as habituais. Veja se o próprio plugin tem um limite de retenção nas definições antes de apagar seja o que for aqui."

#: includes/admin/trait-tables.php:588
msgid "Database tables"
msgstr "Tabelas da base de dados"

#: includes/admin/trait-tables.php:589
msgid "Every table with its engine, row count, size and recoverable overhead. Optimizing reclaims the overhead; it never deletes data. Orphaned custom tables from uninstalled plugins appear in the Orphans tab."
msgstr "Cada tabela com o seu motor, número de linhas, tamanho e sobrecarga recuperável. Otimizar recupera a sobrecarga; nunca elimina dados. As tabelas personalizadas órfãs de plugins desinstalados aparecem no separador Órfãos."

#: includes/admin/trait-tables.php:614
msgid "Recoverable overhead"
msgstr "Sobrecarga recuperável"

#: includes/admin/trait-tables.php:620
msgid "MyISAM tables"
msgstr "Tabelas MyISAM"

#. translators: %s: human-readable size of InnoDB internal free space.
#: includes/admin/trait-tables.php:634
#, php-format
msgid "InnoDB tables also hold %s of internal free space. InnoDB reuses it for new rows, so OPTIMIZE does not hand it back to the operating system — that is normal and not recoverable."
msgstr "As tabelas InnoDB também têm %s de espaço livre interno. O InnoDB reutiliza-o para novas linhas, por isso o OPTIMIZE não o devolve ao sistema operativo: é normal e não é recuperável."

#. translators: %s: human-readable size of recoverable overhead.
#: includes/admin/trait-tables.php:655
#, php-format
msgid "Reclaim %s of overhead now"
msgstr "Recuperar %s de sobrecarga agora"

#: includes/admin/trait-tables.php:660
msgid "Optimizes only the tables with reclaimable overhead. Non-destructive — no data is deleted."
msgstr "Otimiza apenas as tabelas com sobrecarga recuperável. Não destrutivo — nenhum dado é eliminado."

#: includes/admin/trait-tables.php:674
msgid "Orphaned only"
msgstr "Apenas órfãs"

#: includes/admin/trait-tables.php:715
msgid "All tables"
msgstr "Todas as tabelas"

#: includes/admin/trait-tables.php:723
msgid "Search tables"
msgstr "Procurar tabelas"

#: includes/admin/trait-tables.php:728
msgid "Optimizing reclaims overhead and defragments the table. It does not delete data and is safe to run. On InnoDB tables it rebuilds and re-analyses the table, but the reported free space may not drop because InnoDB reuses that space internally instead of returning it to the operating system — that is normal, not a failure."
msgstr "A otimização recupera a sobrecarga e desfragmenta a tabela. Não elimina dados e é seguro executá-la. Em tabelas InnoDB reconstrói e reanalisa a tabela, mas o espaço livre indicado pode não diminuir porque o InnoDB reutiliza esse espaço internamente em vez de o devolver ao sistema operativo: é normal, não uma falha."

#. translators: %d: number of selected tables.
#: includes/admin/trait-tables.php:730
#, php-format
msgid "Optimize the %d selected table(s)?"
msgstr "Otimizar as %d tabelas selecionadas?"

#. translators: %d: number of filtered tables.
#: includes/admin/trait-tables.php:732
#, php-format
msgid "Optimize ALL %d filtered table(s)?"
msgstr "Otimizar TODAS as %d tabelas filtradas?"

#: includes/admin/trait-tables.php:738
msgid "Converting to InnoDB enables row-level locking and crash recovery; it rebuilds the table in place and keeps all data."
msgstr "Converter para InnoDB ativa o bloqueio ao nível da linha e a recuperação após falhas; reconstrói a tabela no local e mantém todos os dados."

#: includes/admin/trait-tables.php:743
msgid "Convert all MyISAM"
msgstr "Converter todas MyISAM"

#. translators: %d: number of selected tables.
#: includes/admin/trait-tables.php:745
#, php-format
msgid "Convert the %d selected table(s) to InnoDB? Only MyISAM tables are changed."
msgstr "Converter a(s) %d tabela(s) selecionada(s) para InnoDB? Apenas as tabelas MyISAM são alteradas."

#. translators: %d: number of MyISAM tables.
#: includes/admin/trait-tables.php:747
