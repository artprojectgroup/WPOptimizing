msgstr "Lo proporciona también %s. Funcionan los dos: hacerlo dos veces es inocuo, así que WPOptimizing no se retira y no hay nada que cambiar."

#. translators: %s: comma-separated plugin names.
#: includes/admin/trait-settings.php:1367
#, php-format
msgid "Provided by %s."
msgstr "Lo proporciona %s."

#. translators: %s: comma-separated plugin names.
#: includes/admin/trait-settings.php:1392
#, php-format
msgid "WPOptimizing covers everything these plugins are used for, so you can manage it all from one place and deactivate them: %s. Check your settings here first."
msgstr "WPOptimizing cubre todo aquello para lo que se usan estos plugins, así que puedes gestionarlo desde un solo sitio y desactivarlos: %s. Revisa antes tus ajustes aquí."

#: includes/admin/trait-settings.php:1410
