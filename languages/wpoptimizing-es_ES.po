#, php-format
msgid "%1$d event is overdue; the oldest by %2$s."
msgid_plural "%1$d events are overdue; the oldest by %2$s."
msgstr[0] "%1$d evento va con retraso; el más antiguo, %2$s."
msgstr[1] "%1$d eventos van con retraso; el más antiguo, %2$s."

#: includes/admin/trait-cron.php:384
msgid "WP-Cron is disabled, so a server cron has to call wp-cron.php: check that the crontab line above is in place and running."
msgstr "WP-Cron está desactivado, así que un cron del servidor tiene que llamar a wp-cron.php: comprueba que la línea del crontab de arriba está puesta y funcionando."

#: includes/admin/trait-cron.php:385
msgid "WP-Cron only runs when someone visits the site, and some hosts block the request it makes to itself. On a quiet site, switch to a server cron with the panel above."
msgstr "WP-Cron solo se ejecuta cuando alguien visita el sitio, y algunos alojamientos bloquean la petición que se hace a sí mismo. En un sitio con pocas visitas, pásate a un cron del servidor con el panel de arriba."

#: includes/admin/trait-cron.php:434
msgid "That scheduled event no longer exists or has no callback."
msgstr "Ese evento programado ya no existe o no tiene callback."

#. translators: %s: hook name.
#: includes/admin/trait-cron.php:442
#, php-format
msgid "%s will run in a moment, in the background."
msgstr "%s se ejecutará en un momento, en segundo plano."

#. translators: %s: hook name.
#: includes/admin/trait-cron.php:444
#, php-format
msgid "%s could not be queued (it may be paused)."
msgstr "No se ha podido poner %s en cola (puede que esté en pausa)."

#: includes/admin/trait-cron.php:454
msgid "WordPress core tasks cannot be paused."
msgstr "Las tareas del núcleo de WordPress no se pueden pausar."

#. translators: %s: hook name.
#: includes/admin/trait-cron.php:464
#, php-format
msgid "%s is paused: it stays scheduled but does nothing until you resume it."
msgstr "%s está en pausa: sigue programado pero no hace nada hasta que lo reanudes."

#. translators: %s: hook name.
#: includes/admin/trait-cron.php:466
#, php-format
msgid "%s resumed."
msgstr "%s reanudado."

#: includes/admin/trait-cron.php:508
msgid "By default WordPress runs scheduled tasks on visitor page loads: this adds latency to random requests and misses tasks on low-traffic sites. Disable WP-Cron and drive it from a real server cron instead for faster page loads and dependable scheduling."
msgstr "De forma predeterminada, WordPress ejecuta las tareas programadas en las cargas de página de los visitantes: esto añade latencia a peticiones aleatorias y omite tareas en sitios con poco tráfico. Desactiva WP-Cron y gestiónalo desde un cron real del servidor para cargas de página más rápidas y una programación fiable."

#: includes/admin/trait-cron.php:513
msgid "WP-Cron disabled"
msgstr "WP-Cron desactivado"

#: includes/admin/trait-cron.php:514
msgid "WordPress no longer fires cron on page loads."
msgstr "WordPress ya no ejecuta cron en las cargas de página."

#: includes/admin/trait-cron.php:516
msgid "Runs on page loads"
msgstr "Se ejecuta en las cargas de página"

#: includes/admin/trait-cron.php:517
msgid "WP-Cron fires on visitor requests (the WordPress default)."
msgstr "WP-Cron se ejecuta en las peticiones de los visitantes (el comportamiento predeterminado de WordPress)."

#: includes/admin/trait-cron.php:521
msgid "Add this line to your server crontab so scheduled tasks keep running every 5 minutes:"
msgstr "Añade esta línea al crontab de tu servidor para que las tareas programadas sigan ejecutándose cada 5 minutos:"

#: includes/admin/trait-cron.php:530
msgid "Re-enable WP-Cron"
msgstr "Reactivar WP-Cron"

#: includes/admin/trait-cron.php:533
msgid "DISABLE_WP_CRON is already defined elsewhere (wp-config.php or a must-use plugin), so there is nothing to change here."
msgstr "DISABLE_WP_CRON ya está definida en otro sitio (wp-config.php o un plugin must-use), así que no hay nada que cambiar aquí."

#: includes/admin/trait-cron.php:542
msgid "Disable WP-Cron"
msgstr "Desactivar WP-Cron"

#: includes/admin/trait-cron.php:544
msgid "This edits wp-config.php and keeps a protected backup copy of it in the plugin's data folder. After disabling, add the crontab line below."
msgstr "Esto edita wp-config.php y guarda una copia de seguridad protegida en la carpeta de datos del plugin. Tras desactivarlo, añade la línea de crontab de abajo."

#: includes/admin/trait-cron.php:547
msgid "wp-config.php is not writable. Add this line by hand, just after its opening <?php tag:"
msgstr "wp-config.php no tiene permisos de escritura. Añade esta línea a mano, justo después de su etiqueta de apertura <?php:"

