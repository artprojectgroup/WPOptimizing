#: includes/admin/trait-media-audit.php:163
msgid "The selected files were deleted. A backup was taken first and is listed under Backups."
msgstr "Se han eliminado los archivos seleccionados. Antes se hizo una copia de seguridad, que aparece en Copias de seguridad."

#: includes/admin/trait-media-audit.php:190
msgid "Nothing found."
msgstr "No se ha encontrado nada."

